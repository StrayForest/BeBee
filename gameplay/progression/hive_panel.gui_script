local catalog = require "data.catalog"
local meadow = require "gameplay.world.meadow"

local DESIGN_W = 1280
local DESIGN_H = 720
local FIRST_MEADOW = catalog.meadows[1]
local MEADOW_CENTER_X = 1800
local MEADOW_CENTER_Y = 950

local CREAM = vmath.vector4(1.0, 0.969, 0.91, 1)
local DARK = vmath.vector4(0.16, 0.13, 0.12, 0.94)
local DARK_SOFT = vmath.vector4(0.16, 0.13, 0.12, 0.72)
local HONEY = vmath.vector4(0.965, 0.718, 0.235, 1)
local ACTIVE = vmath.vector4(0.471, 0.839, 0.910, 1)
local SUCCESS = vmath.vector4(0.416, 0.796, 0.463, 1)
local LOCKED = vmath.vector4(0.482, 0.431, 0.557, 0.92)
local LAVENDER = vmath.vector4(0.73, 0.63, 0.91, 1)

local LIFE_ANCHORS = {
    {1460, 1030}, {1610, 1240}, {1810, 1090}, {1980, 700}, {2170, 980}, {1860, 1320},
}

local function box(x, y, w, h, color)
    local node = gui.new_box_node(vmath.vector3(x, y, 0), vmath.vector3(w, h, 0))
    gui.set_color(node, color)
    return node
end

local function text(x, y, value, scale)
    local node = gui.new_text_node(vmath.vector3(x, y, 0), value)
    gui.set_font(node, "default")
    gui.set_color(node, CREAM)
    gui.set_scale(node, vmath.vector3(scale or 1, scale or 1, 1))
    return node
end

local function enable(nodes, value)
    for _, node in ipairs(nodes) do gui.set_enabled(node, value) end
end

local function world_to_screen(wx, wy, camera_x, camera_y)
    return DESIGN_W * 0.5 + wx - camera_x, DESIGN_H * 0.5 + wy - camera_y
end

local function set_xy(node, x, y)
    gui.set_position(node, vmath.vector3(x, y, 0))
end

local function html5_available()
    return html5 ~= nil and html5.run ~= nil
end

local function query_value(name)
    if not html5_available() then return "" end
    return html5.run("new URLSearchParams(window.location.search).get(" .. json.encode(name) .. ") || ''") or ""
end

local function stage_definition(stage_id)
    for _, definition in ipairs(FIRST_MEADOW.restoration_stages or {}) do
        if definition.id == stage_id then return definition end
    end
    return FIRST_MEADOW.restoration_stages[1]
end

local function garden_text(message)
    local label = message.garden_label or "GARDEN SHOP"
    if message.garden_purchased == true then return label .. "
ALL HOME UPGRADES OWNED" end
    if message.garden_available ~= true then
        if message.garden_reason == "requires_patch" then return label .. "
RESTORE MORE FLOWERS FIRST" end
        if message.garden_reason == "insufficient_honey" then return label .. "
NEED " .. tostring(message.garden_cost or 0) .. " HONEY" end
        return label .. "
LOCKED"
    end
    return label .. "
" .. tostring(message.garden_cost or 0) .. " HONEY  ·  TAP TO BUY"
end

local function card_text(message, kind)
    local level = message[kind .. "_level"] or 1
    local cost = message[kind .. "_cost"] or 0
    local available = message[kind .. "_available"] == true
    local affordable = message[kind .. "_affordable"] == true
    if not available then
        return string.format("LEVEL %d\n%s", level, cost > 0 and "LOCKED" or "MAX")
    end
    if kind == "flight" then
        return string.format("LEVEL %d\n%d → %d U/S\n%d HONEY%s", level, message.flight_speed or 300, message.flight_next_speed or 300, cost, affordable and "" or "  ·  NEED MORE")
    end
    return string.format("LEVEL %d\n%.2f× → %.2f× WORK\n%d HONEY%s", level, message.buzz_multiplier or 1, message.buzz_next_multiplier or 1, cost, affordable and "" or "  ·  NEED MORE")
end

local function publish_restoration_bridge(self, status, stage, ambient_count, celebration_active)
    if not self.qa_enabled or not html5_available() then return end
    html5.run("window.__bebeeRestorationQA = Object.assign(window.__bebeeRestorationQA || {}, " .. json.encode({
        stageId = status.stage_id,
        stageIndex = status.stage_index,
        contribution = status.contribution,
        restorationTarget = status.target,
        restorationProgress = status.progress,
        ambientLifeCount = ambient_count,
        celebrationActive = celebration_active,
        celebrationSeconds = stage.celebration_seconds or 0,
        patch3Completed = self.patch3_completed,
        hudHidden = self.hud_hidden,
    }) .. ")")
end

local function apply_restoration(self)
    local status = meadow.stage_for_contribution(FIRST_MEADOW, self.restoration_contribution or 0)
    local stage = stage_definition(status.stage_id)
    local previous = self.restoration_stage_id
    self.restoration_stage_id = status.stage_id

    local initial_restore_window = (self.restoration_frame or 0) < 60
    if previous ~= nil
        and previous ~= meadow.STAGE_RESTORED
        and status.stage_id == meadow.STAGE_RESTORED
        and not initial_restore_window then
        local seconds = stage.celebration_seconds or 1.5
        self.celebration_until_frame = (self.restoration_frame or 0) + math.floor(seconds * 60 + 0.5)
    end

    local ambient_count = math.min(#self.life_nodes, stage.ambient_life_count or 0)
    for index, life in ipairs(self.life_nodes) do
        local active = index <= ambient_count
        gui.set_enabled(life, active)
        if active then
            local anchor = LIFE_ANCHORS[index]
            local frame = self.restoration_frame or 0
            local wx = anchor[1] + math.sin(frame * 0.035 + index * 1.7) * 22
            local wy = anchor[2] + math.cos(frame * 0.028 + index * 1.3) * 14
            local sx, sy = world_to_screen(wx, wy, self.camera_x or 1200, self.camera_y or 800)
            set_xy(life, sx, sy)
        end
    end

    local celebration_active = status.stage_id == meadow.STAGE_RESTORED
        and (self.celebration_until_frame or -1) >= (self.restoration_frame or 0)
    for index, node in ipairs(self.celebration_nodes) do
        gui.set_enabled(node, celebration_active)
        if celebration_active then
            local frame = self.restoration_frame or 0
            local remaining = math.max(0, (self.celebration_until_frame or frame) - frame)
            local total = math.max(1, math.floor((stage.celebration_seconds or 1.5) * 60 + 0.5))
            local progress = 1 - remaining / total
            local angle = index * (math.pi * 2 / #self.celebration_nodes) + frame * 0.025
            local radius = 55 + 155 * progress
            local wx = MEADOW_CENTER_X + math.cos(angle) * radius
            local wy = MEADOW_CENTER_Y + math.sin(angle) * radius * 0.72
            local sx, sy = world_to_screen(wx, wy, self.camera_x or 1200, self.camera_y or 800)
            set_xy(node, sx, sy)
        end
    end

    publish_restoration_bridge(self, status, stage, ambient_count, celebration_active)
end

function init(self)
    self.qa_enabled = sys.get_config_boolean("bebee.qa_enabled", false)
    self.hud_hidden = self.qa_enabled and query_value("hud_hidden") == "1"
    self.restoration_contribution = 0
    self.restoration_frame = 0
    self.restoration_stage_id = nil
    self.celebration_until_frame = -1
    self.patch3_completed = false
    self.camera_x = 1200
    self.camera_y = 800

    self.hive_body = box(0, 0, 116, 90, HONEY)
    self.hive_door = box(0, 0, 34, 42, DARK)
    self.hive_label = text(0, 0, "HIVE", 0.82)
    self.hive_hint_bg = box(1120, 84, 230, 58, DARK_SOFT)
    self.hive_hint = text(1120, 84, "HIVE  ·  SPACE / TAP", 0.78)

    self.lavender_halo = box(0, 0, 330, 290, vmath.vector4(0.73, 0.63, 0.91, 0.12))
    self.lavender_label = text(0, 0, "REQUIRES BUZZ 2", 0.95)
    self.lavender_flowers = {}
    local offsets = {{-110,-45},{-85,75},{0,115},{85,75},{110,-45}}
    for index, offset in ipairs(offsets) do
        self.lavender_flowers[index] = {
            node = box(0, 0, 28, 28, LAVENDER),
            x = offset[1],
            y = offset[2],
        }
    end

    self.life_nodes = {}
    for index = 1, #LIFE_ANCHORS do
        local color = index % 2 == 0 and vmath.vector4(CREAM.x, CREAM.y, CREAM.z, 0.82)
            or vmath.vector4(ACTIVE.x, ACTIVE.y, ACTIVE.z, 0.78)
        self.life_nodes[index] = box(0, 0, 14, 8, color)
        gui.set_enabled(self.life_nodes[index], false)
    end

    self.celebration_nodes = {}
    for index = 1, 12 do
        local color = index % 3 == 0 and SUCCESS or HONEY
        self.celebration_nodes[index] = box(0, 0, 12, 12, vmath.vector4(color.x, color.y, color.z, 0.62))
        gui.set_enabled(self.celebration_nodes[index], false)
    end

    self.world_nodes = {
        self.hive_body, self.hive_door, self.hive_label,
        self.lavender_halo, self.lavender_label,
    }
    for _, flower in ipairs(self.lavender_flowers) do
        self.world_nodes[#self.world_nodes + 1] = flower.node
    end
    enable(self.world_nodes, false)
    self.world_ready = false

    self.modal_nodes = {}
    self.dim = box(640, 360, 1280, 720, vmath.vector4(0.04, 0.03, 0.03, 0.62))
    self.panel = box(640, 360, 820, 430, DARK)
    self.title = text(640, 535, "HIVE IMPROVEMENTS", 1.28)
    self.balance = text(640, 493, "HONEY 0", 0.92)
    self.help = text(640, 112, "A/D SELECT  ·  SPACE / ENTER BUY\nTAP CARD  ·  ESC CLOSE", 0.84)
    self.flight_card = box(435, 350, 330, 230, vmath.vector4(0.22,0.25,0.26,0.96))
    self.flight_title = text(435, 420, "FLIGHT", 1.15)
    self.flight_body = text(435, 350, "LEVEL 1", 1.00)
    self.flight_note = text(435, 278, "TRAVEL FASTER", 0.82)
    self.buzz_card = box(845, 350, 330, 230, vmath.vector4(0.22,0.25,0.26,0.96))
    self.buzz_title = text(845, 420, "BUZZ", 1.15)
    self.buzz_body = text(845, 350, "LEVEL 1", 1.00)
    self.buzz_note = text(845, 278, "POLLINATE HARDER FLOWERS", 0.82)
    self.garden_card = box(640, 205, 700, 78, vmath.vector4(0.22,0.25,0.26,0.96))
    self.garden_title = text(430, 222, "GARDEN SHOP", 0.92)
    self.garden_body = text(745, 202, "SCENT LANTERN", 0.72)
    self.modal_nodes = {
        self.dim, self.panel, self.title, self.balance, self.help,
        self.flight_card, self.flight_title, self.flight_body, self.flight_note,
        self.buzz_card, self.buzz_title, self.buzz_body, self.buzz_note,
        self.garden_card, self.garden_title, self.garden_body,
    }
    enable(self.modal_nodes, false)
    gui.set_enabled(self.hive_hint_bg, false)
    gui.set_enabled(self.hive_hint, false)
    msg.post("/movement#controller", "progression_view_ready")
end

function on_message(self, message_id, message)
    if message_id == hash("restoration_base") then
        self.restoration_contribution = message.contribution or 0
        self.restoration_frame = message.frame or self.restoration_frame
        self.hud_hidden = message.hud_hidden == true
        apply_restoration(self)
        return
    end
    if message_id ~= hash("progression_view") then return end

    if not self.world_ready then
        self.world_ready = true
        for _, node in ipairs(self.world_nodes) do gui.set_enabled(node, true) end
    end

    local camera_x = message.camera_x or 1200
    local camera_y = message.camera_y or 800
    self.camera_x = camera_x
    self.camera_y = camera_y
    local hx, hy = world_to_screen(message.hive_x or 1120, message.hive_y or 800, camera_x, camera_y)
    set_xy(self.hive_body, hx, hy)
    set_xy(self.hive_door, hx, hy - 18)
    set_xy(self.hive_label, hx, hy + 66)
    gui.set_enabled(self.hive_label, not self.hud_hidden)

    local nearby = message.hive_nearby == true and message.modal_open ~= true and not self.hud_hidden
    gui.set_enabled(self.hive_hint_bg, nearby)
    gui.set_enabled(self.hive_hint, nearby)

    local px, py = world_to_screen(message.patch3_x or 2070, message.patch3_y or 1160, camera_x, camera_y)
    set_xy(self.lavender_halo, px, py)
    local locked = message.patch3_state == "LOCKED"
    local completed_state = message.patch3_state == "COMPLETED"
    self.patch3_completed = completed_state
    msg.post("/movement#view", "restoration_patch3", { completed = completed_state })
    gui.set_color(self.lavender_halo, completed_state and vmath.vector4(SUCCESS.x,SUCCESS.y,SUCCESS.z,0.18) or (locked and vmath.vector4(LOCKED.x,LOCKED.y,LOCKED.z,0.18) or vmath.vector4(LAVENDER.x,LAVENDER.y,LAVENDER.z,0.18)))
    set_xy(self.lavender_label, px, py - 170)
    gui.set_text(self.lavender_label, locked and "REQUIRES BUZZ 2" or (completed_state and "RESTORED" or "LAVENDER"))
    gui.set_color(self.lavender_label, locked and LOCKED or CREAM)
    gui.set_enabled(self.lavender_label, not self.hud_hidden)
    for _, flower in ipairs(self.lavender_flowers) do
        set_xy(flower.node, px + flower.x, py + flower.y)
        gui.set_color(flower.node, locked and LOCKED or LAVENDER)
    end

    local open = message.modal_open == true
    enable(self.modal_nodes, open)
    if not open then
        apply_restoration(self)
        return
    end

    gui.set_text(self.balance, "HONEY " .. tostring(math.floor(message.honey or 0)))
    gui.set_text(self.flight_body, card_text(message, "flight"))
    gui.set_text(self.buzz_body, card_text(message, "buzz"))
    gui.set_text(self.garden_body, garden_text(message))
    local selected = message.selected_upgrade or "flight"
    gui.set_color(self.flight_card, selected == "flight" and vmath.vector4(ACTIVE.x,ACTIVE.y,ACTIVE.z,0.42) or vmath.vector4(0.22,0.25,0.26,0.96))
    gui.set_color(self.buzz_card, selected == "buzz" and vmath.vector4(ACTIVE.x,ACTIVE.y,ACTIVE.z,0.42) or vmath.vector4(0.22,0.25,0.26,0.96))
    gui.set_color(self.garden_card, selected == "garden" and vmath.vector4(HONEY.x,HONEY.y,HONEY.z,0.34) or vmath.vector4(0.22,0.25,0.26,0.96))
    gui.set_color(self.garden_body, message.garden_available == true and CREAM or LOCKED)
    apply_restoration(self)
end
