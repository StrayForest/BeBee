local qa_runtime = require "app.qa_runtime"
local catalog = require "data.catalog"
local input_model = require "gameplay.bee.input"
local movement = require "gameplay.bee.movement"
local follow = require "gameplay.camera.follow"
local flower_patch = require "gameplay.flowers.flower_patch"
local progression = require "systems.progression"
local storage_service = require "systems.storage.storage_service"

local MOVEMENT_EMPTY = "movement_empty"
local MOVEMENT_DENSE = "movement_dense"
local POLLINATION_IDLE = "pollination_idle"
local POLLINATION_ACTIVE = "pollination_active_50"
local POLLINATION_COMPLETE = "pollination_complete"
local HUD_DEFAULT = "hud_default"
local PROGRESSION_HIVE = "progression_hive"
local PROGRESSION_GATE = "progression_buzz_gate"

local HIVE_X = 1120
local HIVE_Y = 800
local HIVE_RADIUS = 190
local HIVE_BUTTON = { x1 = 1000, x2 = 1240, y1 = 45, y2 = 125 }
local FLIGHT_CARD = { x1 = 270, x2 = 600, y1 = 235, y2 = 465 }
local BUZZ_CARD = { x1 = 680, x2 = 1010, y1 = 235, y2 = 465 }

local function html5_available()
    return html5 ~= nil and html5.run ~= nil
end

local function surface_size()
    if window ~= nil and window.get_size ~= nil then
        local width, height = window.get_size()
        if width and height and width > 0 and height > 0 then return width, height end
    end
    return 1280, 720
end

local function query_value(name)
    if not html5_available() then return "" end
    return html5.run("new URLSearchParams(window.location.search).get(" .. json.encode(name) .. ") || ''") or ""
end

local function movement_only_qa(state_id)
    return state_id == MOVEMENT_EMPTY or state_id == MOVEMENT_DENSE
end

local function progression_qa(state_id)
    return state_id == PROGRESSION_HIVE or state_id == PROGRESSION_GATE
end

local function canonical_visual_fixture(state_id)
    return state_id == POLLINATION_IDLE
        or state_id == POLLINATION_ACTIVE
        or state_id == POLLINATION_COMPLETE
        or state_id == HUD_DEFAULT
        or progression_qa(state_id)
end

local function clean_progression(self, persistence_enabled)
    self.save_state = progression.new_save()
    self.persistence_enabled = persistence_enabled == true
    self.last_save_code = self.persistence_enabled and "clean_start" or "not_applicable"
    self.last_save_durability = "not_written"
end

local function lifecycle_value(self)
    if progression_qa(self.qa_state) then return query_value("p3_storage_lifecycle") end
    return query_value("p2_storage_lifecycle")
end

local function load_progression(self)
    self.storage = storage_service.new({ domain_validator = progression.validate_save })
    local storage_test = query_value("storage_test")
    local lifecycle = lifecycle_value(self)

    if storage_test ~= "" or movement_only_qa(self.qa_state) then
        clean_progression(self, false)
        return
    end

    if self.qa_enabled and canonical_visual_fixture(self.qa_state) and lifecycle == "" then
        clean_progression(self, false)
        return
    end

    if self.qa_enabled and canonical_visual_fixture(self.qa_state) and lifecycle == "reset" then
        local deleted = self.storage.delete()
        if not deleted.ok then
            clean_progression(self, false)
            self.last_save_code = "reset_failed:" .. tostring(deleted.code)
            print("BEBEE_PROGRESS storage_reset_failed code=" .. tostring(deleted.code))
            return
        end
        clean_progression(self, true)
        self.last_save_code = "reset_clean"
        return
    end

    local loaded = self.storage.load()
    if loaded.ok and loaded.value ~= nil then
        self.save_state = loaded.value
        self.persistence_enabled = true
        self.last_save_code = loaded.code
        self.last_save_durability = loaded.durability or "not_written"
        print(string.format(
            "BEBEE_PROGRESS save_loaded code=%s honey=%d flight=%d buzz=%d",
            tostring(loaded.code), self.save_state.player.honey,
            progression.current_upgrade_level(self.save_state, "upgrade_flight"),
            progression.current_upgrade_level(self.save_state, "upgrade_buzz")
        ))
        return
    end
    if loaded.ok then
        clean_progression(self, true)
        self.last_save_code = loaded.code
        return
    end

    clean_progression(self, false)
    self.last_save_code = "load_failed:" .. tostring(loaded.code)
    print("BEBEE_PROGRESS save_load_failed code=" .. tostring(loaded.code))
end

local function build_patch_states(self)
    self.patches = {}
    for index, definition in ipairs(catalog.patches) do
        self.patches[index] = flower_patch.new(definition, {
            completed = progression.is_patch_completed(self.save_state, definition.id),
            eligible = progression.is_patch_eligible(self.save_state, definition),
        })
    end
end

local function refresh_patch_eligibility(self)
    for _, state in ipairs(self.patches) do
        flower_patch.set_eligible(state, progression.is_patch_eligible(self.save_state, state.definition))
    end
end

local function mark_completed_fixture(self, patch_index)
    local state = self.patches[patch_index]
    self.save_state.world.campaign_completion[state.definition.id] = true
    state.work = state.work_target
    state.completed = true
    state.state = flower_patch.STATE_COMPLETED
end

local function apply_visual_fixture(self)
    local lifecycle = lifecycle_value(self)
    if not self.qa_enabled or lifecycle == "reload" then return end

    local first = self.patches[1]
    if self.qa_state == POLLINATION_ACTIVE then
        first.work = first.work_target * 0.5
        first.state = flower_patch.STATE_ACTIVE
        self.motion.x = first.definition.x
        self.motion.y = first.definition.y
        self.camera.x = self.motion.x
        self.camera.y = self.motion.y
    elseif self.qa_state == POLLINATION_COMPLETE then
        mark_completed_fixture(self, 1)
        self.save_state.player.honey = first.definition.honey_reward
        refresh_patch_eligibility(self)
        self.reward_amount = first.definition.honey_reward
        self.reward_feedback_remaining = 1000
        self.reward_patch_x = first.definition.x
        self.reward_patch_y = first.definition.y
        self.motion.x = first.definition.x
        self.motion.y = first.definition.y
        self.camera.x = self.motion.x
        self.camera.y = self.motion.y
    elseif self.qa_state == PROGRESSION_HIVE then
        mark_completed_fixture(self, 1)
        self.save_state.player.honey = 45
        refresh_patch_eligibility(self)
        self.motion.x = HIVE_X
        self.motion.y = HIVE_Y
        self.camera.x = HIVE_X
        self.camera.y = HIVE_Y
    elseif self.qa_state == PROGRESSION_GATE then
        mark_completed_fixture(self, 1)
        mark_completed_fixture(self, 2)
        self.save_state.player.honey = 100
        refresh_patch_eligibility(self)
        local third = self.patches[3]
        self.motion.x = HIVE_X
        self.motion.y = HIVE_Y
        -- Start between the Hive and Lavender so the deterministic gate still
        -- shows both the purchase source and the world-space requirement.
        self.camera.x = (HIVE_X + third.definition.x) * 0.5
        self.camera.y = (HIVE_Y + third.definition.y) * 0.5
    end
end

local function save_progression(self)
    if not self.persistence_enabled then
        self.last_save_code = "not_applicable"
        self.last_save_durability = "not_written"
        return false
    end
    local saved = self.storage.save(self.save_state)
    self.last_save_code = saved.code or "save_error"
    self.last_save_durability = saved.durability or "not_written"
    if not saved.ok then
        print("BEBEE_PROGRESS save_failed code=" .. tostring(saved.code))
        return false
    end
    print(string.format(
        "BEBEE_PROGRESS save_accepted code=%s durability=%s bytes=%s",
        tostring(saved.code), tostring(saved.durability),
        tostring(saved.diagnostics and saved.diagnostics.serialized_size_bytes or "n/a")
    ))
    return true
end

local function complete_patch(self, state)
    local result = progression.complete_patch(self.save_state, state.definition)
    if not result.ok then
        print("BEBEE_POLLINATION reward_failed code=" .. tostring(result.code))
        return
    end
    if result.awarded > 0 then
        self.reward_amount = result.awarded
        self.reward_feedback_remaining = 0.38
        self.reward_patch_x = state.definition.x
        self.reward_patch_y = state.definition.y
        self.reward_transactions = self.reward_transactions + 1
    end
    self.pollination_completion_count = self.pollination_completion_count + 1
    self.audio_hook_count = self.audio_hook_count + 1
    refresh_patch_eligibility(self)
    save_progression(self)
    print(string.format(
        "BEBEE_POLLINATION patch_completed id=%s honey_awarded=%d honey_total=%d audio_hook=pollination_complete",
        state.definition.id, result.awarded, result.honey
    ))
end

local function update_pollination(self, movement_distance)
    if not self.pollination_enabled or self.progression_open then return end
    local work_multiplier = progression.buzz_work_multiplier(self.save_state)
    for _, state in ipairs(self.patches) do
        local event = flower_patch.step(state, self.motion.x, self.motion.y, movement_distance, work_multiplier)
        if event.just_completed then complete_patch(self, state) end
    end
end

local function patch_payload_for(self, state)
    local payload = {
        id = state.definition.id,
        x = state.definition.x,
        y = state.definition.y,
        radius = state.definition.radius,
        edgeForgiveness = state.definition.edge_forgiveness or 0,
        work = state.work,
        workTarget = state.work_target,
        progress = flower_patch.progress_ratio(state),
        state = state.state,
        inside = state.inside,
        qualifying = state.qualifying,
        workAddedLastStep = state.work_added_last_step,
        movementDistanceLastStep = state.movement_distance_last_step,
        workMultiplierLastStep = state.work_multiplier_last_step,
        requiresBuzzLevel = state.definition.requires_buzz_level or 1,
    }
    local eligible, reason, requirement = progression.patch_eligibility(self.save_state, state.definition)
    payload.eligible = eligible
    payload.eligibilityReason = reason
    payload.requirement = requirement
    return payload
end

local function hive_nearby(self)
    local dx = self.motion.x - HIVE_X
    local dy = self.motion.y - HIVE_Y
    return dx * dx + dy * dy <= HIVE_RADIUS * HIVE_RADIUS
end

local function upgrade_view(self, upgrade_id)
    local current = progression.current_upgrade_definition(self.save_state, upgrade_id)
    local next_level = progression.next_upgrade_definition(self.save_state, upgrade_id)
    local available = false
    local availability_code = "max_level"
    if next_level then available, availability_code = progression.is_upgrade_available(self.save_state, upgrade_id) end
    return current, next_level, available, availability_code
end

local function send_progression_view(self)
    if not self.pollination_enabled then return end
    local flight, flight_next, flight_available = upgrade_view(self, "upgrade_flight")
    local buzz, buzz_next, buzz_available = upgrade_view(self, "upgrade_buzz")
    local patch3 = self.patches[3]
    msg.post("/progression#view", "progression_view", {
        camera_x = self.camera.x,
        camera_y = self.camera.y,
        hive_x = HIVE_X,
        hive_y = HIVE_Y,
        hive_nearby = hive_nearby(self),
        modal_open = self.progression_open,
        selected_upgrade = self.selected_upgrade,
        honey = self.save_state.player.honey,
        flight_level = progression.current_upgrade_level(self.save_state, "upgrade_flight"),
        flight_speed = flight and flight.max_speed or 300,
        flight_next_speed = flight_next and flight_next.max_speed or (flight and flight.max_speed or 300),
        flight_cost = flight_next and flight_next.cost or 0,
        flight_available = flight_available,
        flight_affordable = flight_next ~= nil and flight_available and self.save_state.player.honey >= flight_next.cost,
        buzz_level = progression.current_upgrade_level(self.save_state, "upgrade_buzz"),
        buzz_multiplier = buzz and buzz.work_multiplier or 1,
        buzz_next_multiplier = buzz_next and buzz_next.work_multiplier or (buzz and buzz.work_multiplier or 1),
        buzz_cost = buzz_next and buzz_next.cost or 0,
        buzz_available = buzz_available,
        buzz_affordable = buzz_next ~= nil and buzz_available and self.save_state.player.honey >= buzz_next.cost,
        patch3_x = patch3.definition.x,
        patch3_y = patch3.definition.y,
        patch3_state = patch3.state,
        patch3_progress = flower_patch.progress_ratio(patch3),
    })
end

local function update_runtime_bridge(self, force)
    if not self.qa_enabled or not html5_available() then return end
    if not force and self.frame % 6 ~= 0 then return end

    local ix, iy, source = input_model.intent(self.input)
    local max_speed = progression.flight_max_speed(self.save_state)
    html5.run("window.__bebeeMovementQA = " .. json.encode({
        schemaVersion = 2,
        stateId = self.qa_state,
        frame = self.frame,
        beeX = self.motion.x,
        beeY = self.motion.y,
        velocityX = self.motion.vx,
        velocityY = self.motion.vy,
        speed = self.motion.speed,
        maxSpeed = max_speed,
        motionState = self.motion.motion_state,
        cameraX = self.camera.x,
        cameraY = self.camera.y,
        intentX = ix,
        intentY = iy,
        inputSource = source,
        reducedMotion = self.reduced_motion,
        boundHits = self.motion.bound_hits,
        distanceTravelled = self.motion.distance_travelled,
    }))

    if self.pollination_enabled then
        html5.run("window.__bebeePollinationQA = " .. json.encode({
            schemaVersion = 2,
            stateId = self.qa_state,
            frame = self.frame,
            honey = self.save_state.player.honey,
            patch1 = patch_payload_for(self, self.patches[1]),
            patch2 = patch_payload_for(self, self.patches[2]),
            patch3 = patch_payload_for(self, self.patches[3]),
            completionCount = self.pollination_completion_count,
            rewardTransactions = self.reward_transactions,
            audioHookCount = self.audio_hook_count,
            extraPollinationInput = false,
            saveCode = self.last_save_code,
            saveDurability = self.last_save_durability,
        }))
        local flight, flight_next, flight_available, flight_code = upgrade_view(self, "upgrade_flight")
        local buzz, buzz_next, buzz_available, buzz_code = upgrade_view(self, "upgrade_buzz")
        html5.run("window.__bebeeProgressionQA = " .. json.encode({
            schemaVersion = 1,
            stateId = self.qa_state,
            frame = self.frame,
            modalOpen = self.progression_open,
            selectedUpgrade = self.selected_upgrade,
            hiveNearby = hive_nearby(self),
            honey = self.save_state.player.honey,
            flightLevel = progression.current_upgrade_level(self.save_state, "upgrade_flight"),
            flightMaxSpeed = flight and flight.max_speed or 300,
            flightNextMaxSpeed = flight_next and flight_next.max_speed or nil,
            flightNextCost = flight_next and flight_next.cost or nil,
            flightAvailable = flight_available,
            flightAvailabilityCode = flight_code,
            buzzLevel = progression.current_upgrade_level(self.save_state, "upgrade_buzz"),
            buzzWorkMultiplier = buzz and buzz.work_multiplier or 1,
            buzzNextWorkMultiplier = buzz_next and buzz_next.work_multiplier or nil,
            buzzNextCost = buzz_next and buzz_next.cost or nil,
            buzzAvailable = buzz_available,
            buzzAvailabilityCode = buzz_code,
            patch3 = patch_payload_for(self, self.patches[3]),
            saveCode = self.last_save_code,
            saveDurability = self.last_save_durability,
        }))
    end
end

local function mark_capture_ready(self)
    if not self.qa_enabled or not html5_available() then return end
    local state_json = json.encode(self.qa_state)
    local frame = self.frame
    html5.run([[
        (() => {
            const qa = window.__bebeeQA;
            if (!qa || qa.stateId !== ]] .. state_json .. [[) return "missing";
            qa.captureReady = true;
            qa.simulationFrame = ]] .. tostring(frame) .. [[;
            return "ok";
        })()
    ]])
    print(string.format("BEBEE_QA capture_ready state=%s seed=88008 frame=%d", self.qa_state, self.frame))
end

local function active_patch_position(self)
    for _, state in ipairs(self.patches) do
        if state.qualifying then return state.definition.x, state.definition.y end
    end
    return 0, 0
end

local function send_view(self)
    local touch = input_model.touch_visual(self.input)
    local width, height = surface_size()
    local sx = 1280 / width
    local sy = 720 / height
    local patch1 = self.patches[1]
    local patch2 = self.patches[2]
    local active_x, active_y = active_patch_position(self)
    msg.post("#view", "view_state", {
        bee_x = self.motion.x,
        bee_y = self.motion.y,
        camera_x = self.camera.x,
        camera_y = self.camera.y,
        speed = self.motion.speed,
        facing_x = self.motion.facing_x,
        dense = self.dense,
        touch_active = touch.active == true and not self.progression_open,
        touch_anchor_x = (touch.anchor_x or 0) * sx,
        touch_anchor_y = (touch.anchor_y or 0) * sy,
        touch_knob_x = (touch.knob_x or 0) * sx,
        touch_knob_y = (touch.knob_y or 0) * sy,
        pollination_visible = self.pollination_enabled,
        patch1_x = patch1.definition.x,
        patch1_y = patch1.definition.y,
        patch1_state = patch1.state,
        patch1_progress = flower_patch.progress_ratio(patch1),
        patch1_qualifying = patch1.qualifying,
        patch2_x = patch2.definition.x,
        patch2_y = patch2.definition.y,
        patch2_state = patch2.state,
        patch2_progress = flower_patch.progress_ratio(patch2),
        patch2_qualifying = patch2.qualifying,
        honey = self.save_state.player.honey,
        reward_amount = self.reward_amount,
        reward_timer = self.reward_feedback_remaining,
        reward_patch_x = self.reward_patch_x,
        reward_patch_y = self.reward_patch_y,
        active_patch_x = active_x,
        active_patch_y = active_y,
        frame = self.frame,
    })
    send_progression_view(self)
end

local function open_progression(self)
    if self.progression_open or not hive_nearby(self) then return false end
    self.progression_open = true
    self.selected_upgrade = "flight"
    input_model.clear(self.input)
    self.motion.vx = 0
    self.motion.vy = 0
    msg.post("/modal#controller", "open_modal", { mode = "progression" })
    send_progression_view(self)
    update_runtime_bridge(self, true)
    print("BEBEE_P3 hive_open")
    return true
end

local function purchase_selected(self, upgrade_id)
    upgrade_id = upgrade_id or (self.selected_upgrade == "buzz" and "upgrade_buzz" or "upgrade_flight")
    local result = progression.purchase_upgrade(self.save_state, upgrade_id)
    if result.ok then
        refresh_patch_eligibility(self)
        save_progression(self)
        print(string.format("BEBEE_P3 upgrade_purchased id=%s level=%d cost=%d honey=%d", upgrade_id, result.level, result.cost, result.honey))
    else
        print(string.format("BEBEE_P3 upgrade_rejected id=%s code=%s honey=%d", upgrade_id, tostring(result.code), self.save_state.player.honey))
    end
    send_progression_view(self)
    update_runtime_bridge(self, true)
    return result.ok
end

local function design_point(x, y)
    local width, height = surface_size()
    return (x or 0) * 1280 / width, (y or 0) * 720 / height
end

local function inside(rect, x, y)
    return x >= rect.x1 and x <= rect.x2 and y >= rect.y1 and y <= rect.y2
end

function init(self)
    self.qa_enabled = sys.get_config_boolean("bebee.qa_enabled", false)
    self.qa_state = query_value("qa")
    self.dense = self.qa_state == MOVEMENT_DENSE
    self.reduced_motion = query_value("reduced_motion") == "1"
    if html5_available() and query_value("reduced_motion") == "" then
        self.reduced_motion = html5.run("window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches") == true
    end

    local width, height = surface_size()
    self.input = input_model.new({ surface_width = width, surface_height = height })
    self.motion = movement.new()
    self.camera = follow.new()
    self.frame = 0
    self.view_ready = false
    self.progression_view_ready = false
    self.qa_ready_sent = false
    self.pollination_completion_count = 0
    self.reward_transactions = 0
    self.audio_hook_count = 0
    self.reward_amount = 0
    self.reward_feedback_remaining = 0
    self.reward_patch_x = 0
    self.reward_patch_y = 0
    self.progression_open = false
    self.selected_upgrade = "flight"
    self.pollination_enabled = not movement_only_qa(self.qa_state) and query_value("storage_test") == ""

    load_progression(self)
    build_patch_states(self)
    apply_visual_fixture(self)

    go.set("#camera", "orthographic_zoom", 1.0)
    go.set_position(vmath.vector3(self.camera.x, self.camera.y, 0))
end

function final(self)
    if self.qa_enabled and html5_available() then
        html5.run("delete window.__bebeeMovementQA; delete window.__bebeePollinationQA; delete window.__bebeeProgressionQA")
    end
end

function update(self, dt)
    self.frame = self.frame + 1
    local width, height = surface_size()
    input_model.resize(self.input, width, height)
    local ix, iy = input_model.intent(self.input)
    if self.progression_open then ix, iy = 0, 0 end
    local distance_before = self.motion.distance_travelled
    movement.step(self.motion, ix, iy, dt, { max_speed = progression.flight_max_speed(self.save_state) })
    local movement_distance = self.motion.distance_travelled - distance_before
    update_pollination(self, movement_distance)
    follow.step(self.camera, self.motion.x, self.motion.y, dt, self.reduced_motion)
    go.set_position(vmath.vector3(self.camera.x, self.camera.y, 0))

    if self.reward_feedback_remaining > 0 and self.reward_feedback_remaining < 900 then
        self.reward_feedback_remaining = math.max(0, self.reward_feedback_remaining - dt)
    end

    send_view(self)
    update_runtime_bridge(self, false)

    local required_views_ready = self.view_ready and (not progression_qa(self.qa_state) or self.progression_view_ready)
    if required_views_ready and self.qa_enabled
        and qa_runtime.requires_gameplay_capture(self.qa_state)
        and not self.qa_ready_sent and self.frame >= 2 then
        self.qa_ready_sent = true
        update_runtime_bridge(self, true)
        mark_capture_ready(self)
    end
end

function on_message(self, message_id, message)
    if message_id == hash("view_ready") then
        self.view_ready = true
        send_view(self)
        return
    end
    if message_id == hash("progression_view_ready") then
        self.progression_view_ready = true
        send_progression_view(self)
        return
    end
    if message_id == hash("movement_input_clear") then
        input_model.clear(self.input)
        return
    end
    if message_id == hash("movement_key_input") then
        if message.pressed then input_model.set_key(self.input, message.action_name, true)
        elseif message.released then input_model.set_key(self.input, message.action_name, false) end
        return
    end
    if message_id == hash("progression_primary") then
        open_progression(self)
        return
    end
    if message_id == hash("progression_modal_closed") then
        self.progression_open = false
        input_model.clear(self.input)
        send_progression_view(self)
        update_runtime_bridge(self, true)
        print("BEBEE_P3 hive_closed")
        return
    end
    if message_id == hash("progression_modal_navigation") and self.progression_open then
        if message.action_name == "move_left" or message.action_name == "move_up" then self.selected_upgrade = "flight" end
        if message.action_name == "move_right" or message.action_name == "move_down" then self.selected_upgrade = "buzz" end
        send_progression_view(self)
        update_runtime_bridge(self, true)
        return
    end
    if message_id == hash("progression_modal_purchase") and self.progression_open then
        purchase_selected(self)
        return
    end
    if message_id == hash("progression_modal_pointer") and self.progression_open then
        local x, y = design_point(message.x, message.y)
        if inside(FLIGHT_CARD, x, y) then
            self.selected_upgrade = "flight"
            purchase_selected(self, "upgrade_flight")
        elseif inside(BUZZ_CARD, x, y) then
            self.selected_upgrade = "buzz"
            purchase_selected(self, "upgrade_buzz")
        end
        return
    end
    if message_id == hash("movement_pointer_input") then
        local width, height = surface_size()
        input_model.resize(self.input, width, height)
        if message.pressed then
            local x, y = design_point(message.x, message.y)
            if hive_nearby(self) and inside(HIVE_BUTTON, x, y) and open_progression(self) then return end
            input_model.pointer_press(self.input, message.x, message.y)
        elseif message.released then
            input_model.pointer_release(self.input, message.x, message.y)
        else
            input_model.pointer_move(self.input, message.x, message.y)
        end
        return
    end
    if message_id == hash("movement_pointer_move") then
        input_model.pointer_move(self.input, message.x, message.y)
    end
end
