local qa_runtime = require "app.qa_runtime"
local catalog = require "data.catalog"
local input_model = require "gameplay.bee.input"
local movement = require "gameplay.bee.movement"
local follow = require "gameplay.camera.follow"
local flower_patch = require "gameplay.flowers.flower_patch"
local region = require "gameplay.world.region"
local puzzle = require "gameplay.world.puzzle"
local progression = require "systems.progression"
local analytics = require "systems.analytics"
local analytics_adapter = require "adapters.analytics.console_adapter"
local storage_service = require "systems.storage.storage_service"
local portal = require "adapters.portal.service"
local privacy = require "systems.privacy_consent"

local MOVEMENT_EMPTY = "movement_empty"
local MOVEMENT_DENSE = "movement_dense"
local POLLINATION_IDLE = "pollination_idle"
local POLLINATION_ACTIVE = "pollination_active_50"
local POLLINATION_COMPLETE = "pollination_complete"
local HUD_DEFAULT = "hud_default"
local PROGRESSION_HIVE = "progression_hive"
local PROGRESSION_GATE = "progression_buzz_gate"
local MEADOW_DORMANT = "meadow_dormant"
local MEADOW_MID = "meadow_mid"
local MEADOW_RESTORED = "meadow_restored"
local SEED_LOCKED = "seed_locked"
local SEED_UNLOCKED = "seed_unlocked"
local REGION_START = "region_start"
local REGION_MID = "region_mid"
local REGION_COMPLETE = "region_complete"
local SETTINGS_ACCESSIBILITY = "settings_accessibility"
local ROSEWOOD_START = "rosewood_start"
local ROSEWOOD_MID = "rosewood_mid"
local ROSEWOOD_COMPLETE = "rosewood_complete"
local ALPINE_BLOOM_START = "alpine_bloom_start"
local ALPINE_BLOOM_MID = "alpine_bloom_mid"
local ALPINE_BLOOM_COMPLETE = "alpine_bloom_complete"
local MOON_GARDEN_START = "moon_garden_start"
local MOON_GARDEN_MID = "moon_garden_mid"
local MOON_GARDEN_COMPLETE = "moon_garden_complete"

local HIVE_X = 1120
local HIVE_Y = 800
local HIVE_RADIUS = 190
local HIVE_BUTTON = { x1 = 1000, x2 = 1240, y1 = 45, y2 = 125 }
local FLIGHT_CARD = { x1 = 270, x2 = 600, y1 = 235, y2 = 465 }
local BUZZ_CARD = { x1 = 680, x2 = 1010, y1 = 235, y2 = 465 }
local GARDEN_CARD = { x1 = 290, x2 = 990, y1 = 155, y2 = 230 }
local SETTINGS_REDUCED_ROW = { x1 = 330, x2 = 950, y1 = 350, y2 = 440 }
local SETTINGS_AUDIO_ROW = { x1 = 330, x2 = 950, y1 = 235, y2 = 325 }
local MEADOW_CENTER_X = 1800
local MEADOW_CENTER_Y = 950
local PLOT_POINTER_RADIUS = 96
local P6_REGION_ID = "region_01"
local HOME_MODE = "home"
local ZONE_MODE = "zone"
local PORTAL_INTERACTION_RADIUS = 160
local ENEMY_CONTACT_RADIUS = 86
local send_view
local update_runtime_bridge
local screen_to_world

local function html5_available()
    return html5 ~= nil and html5.run ~= nil
end

local function surface_size()
    if window ~= nil and window.get_size ~= nil then
        local width, height = window.get_size()
        if width and height and width > 0 and height > 0 then return width, height end
    end
    return 1280, 720
end

local function query_value(name)
    if not html5_available() then return "" end
    return html5.run("new URLSearchParams(window.location.search).get(" .. json.encode(name) .. ") || ''") or ""
end

local function movement_only_qa(state_id)
    return state_id == MOVEMENT_EMPTY or state_id == MOVEMENT_DENSE
end

local function progression_qa(state_id)
    return state_id == PROGRESSION_HIVE or state_id == PROGRESSION_GATE
end

local function restoration_qa(state_id)
    return state_id == MEADOW_DORMANT or state_id == MEADOW_MID or state_id == MEADOW_RESTORED
end

local function seed_qa(state_id)
    return state_id == SEED_LOCKED or state_id == SEED_UNLOCKED
end

local function rosewood_qa(state_id)
    return state_id == ROSEWOOD_START or state_id == ROSEWOOD_MID or state_id == ROSEWOOD_COMPLETE
end

local function alpine_bloom_qa(state_id)
    return state_id == ALPINE_BLOOM_START or state_id == ALPINE_BLOOM_MID or state_id == ALPINE_BLOOM_COMPLETE
end

local function moon_garden_qa(state_id)
    return state_id == MOON_GARDEN_START or state_id == MOON_GARDEN_MID or state_id == MOON_GARDEN_COMPLETE
end

local function region_qa(state_id)
    return state_id == REGION_START or state_id == REGION_MID or state_id == REGION_COMPLETE or state_id == SETTINGS_ACCESSIBILITY or rosewood_qa(state_id) or alpine_bloom_qa(state_id) or moon_garden_qa(state_id)
end

local function runtime_region_id(self)
    if moon_garden_qa(self.qa_state) then return "region_06" end
    if alpine_bloom_qa(self.qa_state) then return "region_05" end
    if rosewood_qa(self.qa_state) then return "region_04" end
    if region_qa(self.qa_state) then return P6_REGION_ID end
    if self.zone_region_id then return self.zone_region_id end
    if self.save_state then return region.active_id(self.save_state) or P6_REGION_ID end
    return P6_REGION_ID
end

local function canonical_visual_fixture(state_id)
    return state_id == POLLINATION_IDLE
        or state_id == POLLINATION_ACTIVE
        or state_id == POLLINATION_COMPLETE
        or state_id == HUD_DEFAULT
        or progression_qa(state_id)
        or restoration_qa(state_id)
        or seed_qa(state_id)
        or region_qa(state_id)
end

local function clean_progression(self, persistence_enabled)
    self.save_state = progression.new_save()
    self.persistence_enabled = persistence_enabled == true
    self.last_save_code = self.persistence_enabled and "clean_start" or "not_applicable"
    self.last_save_durability = "not_written"
end

local function lifecycle_value(self)
    if moon_garden_qa(self.qa_state) then return query_value("moon_garden_storage_lifecycle") end
    if alpine_bloom_qa(self.qa_state) then return query_value("alpine_bloom_storage_lifecycle") end
    if rosewood_qa(self.qa_state) then return query_value("rosewood_storage_lifecycle") end
    if region_qa(self.qa_state) then return query_value("p6_storage_lifecycle") end
    if seed_qa(self.qa_state) then return query_value("p5_storage_lifecycle") end
    if progression_qa(self.qa_state) then return query_value("p3_storage_lifecycle") end
    if restoration_qa(self.qa_state) then return query_value("p4_storage_lifecycle") end
    return query_value("p2_storage_lifecycle")
end

local function load_progression(self)
    self.storage = storage_service.new({ domain_validator = progression.validate_save })
    local storage_test = query_value("storage_test")
    local lifecycle = lifecycle_value(self)

    if storage_test ~= "" or movement_only_qa(self.qa_state) then
        clean_progression(self, false)
        return
    end

    if self.qa_enabled and canonical_visual_fixture(self.qa_state) and lifecycle == "" then
        clean_progression(self, false)
        return
    end

    if self.qa_enabled and canonical_visual_fixture(self.qa_state) and lifecycle == "reset" then
        local deleted = self.storage.delete()
        if not deleted.ok then
            clean_progression(self, false)
            self.last_save_code = "reset_failed:" .. tostring(deleted.code)
            print("BEBEE_PROGRESS storage_reset_failed code=" .. tostring(deleted.code))
            return
        end
        clean_progression(self, true)
        self.last_save_code = "reset_clean"
        return
    end

    local loaded = self.storage.load()
    if loaded.ok and loaded.value ~= nil then
        self.save_state = loaded.value
        self.persistence_enabled = true
        self.last_save_code = loaded.code
        self.last_save_durability = loaded.durability or "not_written"
        print(string.format(
            "BEBEE_PROGRESS save_loaded code=%s version=%d honey=%d flight=%d buzz=%d seeds=%d",
            tostring(loaded.code), self.save_state.save_version, self.save_state.player.honey,
            progression.current_upgrade_level(self.save_state, "upgrade_flight"),
            progression.current_upgrade_level(self.save_state, "upgrade_buzz"),
            #progression.owned_seed_ids(self.save_state)
        ))
        return
    end
    if loaded.ok then
        clean_progression(self, true)
        self.last_save_code = loaded.code
        return
    end

    clean_progression(self, false)
    self.last_save_code = "load_failed:" .. tostring(loaded.code)
    print("BEBEE_PROGRESS save_load_failed code=" .. tostring(loaded.code))
end

local function apply_audio_setting(self)
    local muted = progression.get_setting(self.save_state, "audio_muted") == true
    pcall(sound.set_group_gain, "master", muted and 0 or 1)
end

local function track(self, name, properties)
    if not self.analytics then return end
    local _, error_code = analytics.track(self.analytics, name, properties)
    if error_code then print("BEBEE_ANALYTICS rejected=" .. tostring(error_code)) end
end

local function portal_event(self, method, reason)
    if not self.portal or type(portal[method]) ~= "function" then return end
    local result = portal[method](self.portal, reason)
    if result and result.ok == false then
        print("BEBEE_PORTAL rejected=" .. tostring(result.code))
    end
end

local function mark_first_input(self, input_name)
    if self.first_input_seen then return end
    self.first_input_seen = true
    portal_event(self, "gameplay_start", input_name or "first_input")
    track(self, "first_input", { input = input_name or "unknown", region_id = runtime_region_id(self) })
    track(self, "gameplay_start", { reason = input_name or "first_input", region_id = runtime_region_id(self) })
end

local function build_patch_states(self)
    self.patches = {}
    for index, definition in ipairs(catalog.patches) do
        self.patches[index] = flower_patch.new(definition, {
            completed = progression.is_patch_completed(self.save_state, definition.id),
            eligible = progression.is_patch_eligible(self.save_state, definition),
        })
    end
end

local function refresh_patch_eligibility(self)
    for _, state in ipairs(self.patches) do
        flower_patch.set_eligible(state, progression.is_patch_eligible(self.save_state, state.definition))
    end
end

local function mark_completed_fixture(self, patch_index)
    local state = self.patches[patch_index]
    self.save_state.world.campaign_completion[state.definition.id] = true
    state.work = state.work_target
    state.completed = true
    state.state = flower_patch.STATE_COMPLETED
end

local function prepare_restoration_fixture(self, completed_count)
    mark_completed_fixture(self, 1)
    self.save_state.player.honey = 100
    local purchased = progression.purchase_upgrade(self.save_state, "upgrade_buzz")
    if not purchased.ok then error("P4 QA fixture could not purchase Buzz 2: " .. tostring(purchased.code)) end
    if completed_count >= 2 then mark_completed_fixture(self, 2) end
    if completed_count >= 3 then mark_completed_fixture(self, 3) end
    refresh_patch_eligibility(self)
    self.motion.x = MEADOW_CENTER_X
    self.motion.y = MEADOW_CENTER_Y
    self.camera.x = MEADOW_CENTER_X
    self.camera.y = MEADOW_CENTER_Y
end

local function prepare_seed_fixture(self, unlocked)
    local plot = catalog.player_plots[1]
    self.motion.x = plot.x - 80
    self.motion.y = plot.y
    self.camera.x = (plot.x + catalog.patches[1].x) * 0.5
    self.camera.y = (plot.y + catalog.patches[1].y) * 0.5
    if not unlocked then return end

    mark_completed_fixture(self, 1)
    self.save_state.player.honey = catalog.patches[1].honey_reward
    refresh_patch_eligibility(self)
    local planted = progression.interact_player_plot(self.save_state, plot.id)
    if not planted.ok or not planted.changed then
        error("P5 QA fixture could not unlock/plant Daisy: " .. tostring(planted.code))
    end
end

local function mark_meadow_fixture(self, meadow_definition)
    for patch_index, patch_definition in ipairs(catalog.patches) do
        if patch_definition.meadow_id == meadow_definition.id then mark_completed_fixture(self, patch_index) end
    end
end

local function prepare_region_fixture(self, completed_meadows)
    local meadow_count = math.min(completed_meadows, #catalog.meadows)
    for meadow_index = 1, meadow_count do mark_meadow_fixture(self, catalog.meadows[meadow_index]) end

    if completed_meadows >= 1 then
        self.save_state.player.upgrades.upgrade_flight = 2
        self.save_state.player.upgrades.upgrade_buzz = 2
    end
    if completed_meadows >= 4 then
        self.save_state.player.upgrades.upgrade_flight = 3
        self.save_state.player.upgrades.upgrade_buzz = 3
    end
    if completed_meadows >= 6 then
        self.save_state.player.seed_unlocks.seed_daisy = true
        self.save_state.world.player_plants[catalog.player_plots[1].id] = "flower_daisy"
        self.save_state.player.honey = 346
    else
        self.save_state.player.honey = 120
    end
    refresh_patch_eligibility(self)

    local target_index = math.min(6, math.max(1, completed_meadows + 1))
    local target = catalog.meadows[target_index]
    self.motion.x = target.center_x
    self.motion.y = target.center_y
    self.camera.x = target.center_x
    self.camera.y = target.center_y
end

local function first_patch_for_region(region_id)
    for _, definition in ipairs(catalog.patches or {}) do
        if region.region_id_for_meadow(definition.meadow_id) == region_id then return definition end
    end
    return nil
end

local function go_home(self)
    self.world_mode = HOME_MODE
    self.zone_region_id = nil
    self.zone_puzzle = nil
    self.zone_puzzle_solved = false
    self.motion.x, self.motion.y = HIVE_X, HIVE_Y
    self.motion.vx, self.motion.vy = 0, 0
    self.camera.x, self.camera.y = HIVE_X, HIVE_Y
    self.home_return_timer = 0
end

local function enter_active_portal(self, definition)
    if not definition or self.world_mode ~= HOME_MODE then return false end
    local active = region.active_portal(self.save_state)
    if not active or active.id ~= definition.id then return false end
    local available, reason = region.portal_status(self.save_state, definition.id)
    if not available or reason == "restored" then return false end
    self.world_mode = ZONE_MODE
    self.zone_region_id = definition.region_id
    self.zone_puzzle = puzzle.new(region.puzzle_for_region(definition.region_id))
    self.zone_puzzle_solved = self.zone_puzzle.solved
    local first = first_patch_for_region(definition.region_id)
    if first then
        self.motion.x, self.motion.y = first.x, first.y
        self.camera.x, self.camera.y = first.x, first.y
    end
    self.motion.vx, self.motion.vy = 0, 0
    pcall(sound.play, "#portal_whoosh")
    track(self, "portal_entered", { portal_id = definition.id, region_id = definition.region_id })
    input_model.clear(self.input)
    send_view(self)
    update_runtime_bridge(self, true)
    return true
end

local function update_zone_puzzle(self)
    if self.world_mode ~= ZONE_MODE or self.zone_puzzle_solved then return end
    local event = puzzle.step(self.zone_puzzle, self.motion.x, self.motion.y)
    if event.solved then
        self.zone_puzzle_solved = true
        pcall(sound.play, "#pollen_chime")
        track(self, "zone_puzzle_completed", {
            region_id = runtime_region_id(self),
            wrong_attempts = self.zone_puzzle.wrong_attempts,
        })
    elseif event.advanced or event.wrong then
        track(self, event.advanced and "zone_route_step" or "zone_route_miss", {
            region_id = runtime_region_id(self),
            checkpoint = event.checkpoint,
        })
    end
end

local function update_enemies(self, dt)
    self.pest_alert_remaining = math.max(0, (self.pest_alert_remaining or 0) - dt)
    self.pest_slow_remaining = math.max(0, (self.pest_slow_remaining or 0) - dt)
    self.pest_contact_cooldown = math.max(0, (self.pest_contact_cooldown or 0) - dt)
    if self.world_mode ~= ZONE_MODE then return end
    local base = first_patch_for_region(self.zone_region_id or runtime_region_id(self))
    if not base then return end
    for index, enemy in ipairs(self.enemies or {}) do
        local angle = self.frame * (0.014 + index * 0.002) + enemy.phase
        enemy.x = base.x + math.cos(angle) * enemy.orbit_x
        enemy.y = base.y + math.sin(angle * 1.17) * enemy.orbit_y
        local dx, dy = self.motion.x - enemy.x, self.motion.y - enemy.y
        if dx * dx + dy * dy <= ENEMY_CONTACT_RADIUS * ENEMY_CONTACT_RADIUS and self.pest_contact_cooldown <= 0 then
            self.pest_contact_cooldown = 1.25
            self.pest_slow_remaining = 0.65
            self.pest_alert_remaining = 0.8
            self.pest_contact_count = (self.pest_contact_count or 0) + 1
            pcall(sound.play, "#pest_alert")
            track(self, "pest_contact", {
                region_id = runtime_region_id(self),
                contact_count = self.pest_contact_count,
            })
        end
    end
end

local function prepare_expansion_fixture(self, completed_meadows, honey, target_index)
    local meadow_count = math.min(completed_meadows, #catalog.meadows)
    for meadow_index = 1, meadow_count do mark_meadow_fixture(self, catalog.meadows[meadow_index]) end
    self.save_state.player.upgrades.upgrade_flight = 3
    self.save_state.player.upgrades.upgrade_buzz = 3
    self.save_state.player.seed_unlocks.seed_daisy = true
    self.save_state.world.player_plants[catalog.player_plots[1].id] = "flower_daisy"
    self.save_state.player.honey = honey
    refresh_patch_eligibility(self)

    local target = catalog.meadows[math.min(#catalog.meadows, math.max(1, target_index or completed_meadows + 1))]
    self.motion.x = target.center_x
    self.motion.y = target.center_y
    self.camera.x = target.center_x
    self.camera.y = target.center_y
end

local function apply_visual_fixture(self)
    if self.qa_enabled then
        self.world_mode = ZONE_MODE
        self.zone_puzzle_solved = true
    end
    local lifecycle = lifecycle_value(self)
    if not self.qa_enabled or lifecycle == "reload" then return end

    local first = self.patches[1]
    if self.qa_state == POLLINATION_ACTIVE then
        first.work = first.work_target * 0.5
        first.state = flower_patch.STATE_ACTIVE
        self.motion.x = first.definition.x
        self.motion.y = first.definition.y
        self.camera.x = self.motion.x
        self.camera.y = self.motion.y
    elseif self.qa_state == POLLINATION_COMPLETE then
        mark_completed_fixture(self, 1)
        self.save_state.player.honey = first.definition.honey_reward
        refresh_patch_eligibility(self)
        self.reward_amount = first.definition.honey_reward
        self.reward_feedback_remaining = 1000
        self.reward_patch_x = first.definition.x
        self.reward_patch_y = first.definition.y
        self.motion.x = first.definition.x
        self.motion.y = first.definition.y
        self.camera.x = self.motion.x
        self.camera.y = self.motion.y
    elseif self.qa_state == PROGRESSION_HIVE then
        mark_completed_fixture(self, 1)
        self.save_state.player.honey = 45
        refresh_patch_eligibility(self)
        self.motion.x = HIVE_X
        self.motion.y = HIVE_Y
        self.camera.x = HIVE_X
        self.camera.y = HIVE_Y
    elseif self.qa_state == PROGRESSION_GATE then
        mark_completed_fixture(self, 1)
        mark_completed_fixture(self, 2)
        self.save_state.player.honey = 100
        refresh_patch_eligibility(self)
        local third = self.patches[3]
        self.motion.x = HIVE_X
        self.motion.y = HIVE_Y
        self.camera.x = (HIVE_X + third.definition.x) * 0.5
        self.camera.y = (HIVE_Y + third.definition.y) * 0.5
    elseif self.qa_state == MEADOW_DORMANT then
        self.motion.x = MEADOW_CENTER_X
        self.motion.y = MEADOW_CENTER_Y
        self.camera.x = MEADOW_CENTER_X
        self.camera.y = MEADOW_CENTER_Y
    elseif self.qa_state == MEADOW_MID then
        prepare_restoration_fixture(self, 2)
    elseif self.qa_state == MEADOW_RESTORED then
        prepare_restoration_fixture(self, 3)
    elseif self.qa_state == SEED_LOCKED then
        prepare_seed_fixture(self, false)
    elseif self.qa_state == SEED_UNLOCKED then
        prepare_seed_fixture(self, true)
    elseif self.qa_state == REGION_START then
        if lifecycle ~= "reset" then
            prepare_region_fixture(self, 0)
        end
    elseif self.qa_state == REGION_MID then
        prepare_region_fixture(self, 3)
    elseif self.qa_state == REGION_COMPLETE then
        prepare_region_fixture(self, 6)
    elseif self.qa_state == SETTINGS_ACCESSIBILITY then
        prepare_region_fixture(self, 3)
        progression.set_setting(self.save_state, "reduced_motion", true)
        progression.set_setting(self.save_state, "audio_muted", true)
        self.reduced_motion = true
        self.settings_open = true
        self.selected_setting = "reduced_motion"
        apply_audio_setting(self)
        msg.post("/modal#controller", "open_modal", { mode = "settings" })
    elseif self.qa_state == ROSEWOOD_START then
        prepare_expansion_fixture(self, 14, 1596, 15)
    elseif self.qa_state == ROSEWOOD_MID then
        prepare_expansion_fixture(self, 16, 2021, 17)
    elseif self.qa_state == ROSEWOOD_COMPLETE then
        prepare_expansion_fixture(self, 18, 2506, 18)
    elseif self.qa_state == ALPINE_BLOOM_START then
        prepare_expansion_fixture(self, 18, 2506, 19)
    elseif self.qa_state == ALPINE_BLOOM_MID then
        prepare_expansion_fixture(self, 20, 3041, 21)
    elseif self.qa_state == ALPINE_BLOOM_COMPLETE then
        prepare_expansion_fixture(self, 22, 3636, 22)
    elseif self.qa_state == MOON_GARDEN_START then
        prepare_expansion_fixture(self, 22, 3636, 23)
    elseif self.qa_state == MOON_GARDEN_MID then
        prepare_expansion_fixture(self, 24, 4211, 25)
    elseif self.qa_state == MOON_GARDEN_COMPLETE then
        prepare_expansion_fixture(self, 26, 4846, 26)
    end
end

local function save_progression(self)
    if not self.persistence_enabled then
        self.last_save_code = "not_applicable"
        self.last_save_durability = "not_written"
        return false
    end
    local saved = self.storage.save(self.save_state)
    self.last_save_code = saved.code or "save_error"
    self.last_save_durability = saved.durability or "not_written"
    if not saved.ok then
        print("BEBEE_PROGRESS save_failed code=" .. tostring(saved.code))
        return false
    end
    print(string.format(
        "BEBEE_PROGRESS save_accepted code=%s durability=%s bytes=%s",
        tostring(saved.code), tostring(saved.durability),
        tostring(saved.diagnostics and saved.diagnostics.serialized_size_bytes or "n/a")
    ))
    return true
end

local function complete_patch(self, state)
    local completed_region_id = region.region_id_for_meadow(state.definition.meadow_id) or runtime_region_id(self)
    local meadow_before = region.meadow_status(self.save_state, state.definition.meadow_id)
    local region_before = region.summary(self.save_state, completed_region_id)
    local result = progression.complete_patch(self.save_state, state.definition)
    if not result.ok then
        print("BEBEE_POLLINATION reward_failed code=" .. tostring(result.code))
        return
    end
    if result.awarded > 0 then
        self.reward_amount = result.awarded
        self.reward_feedback_remaining = 0.38
        self.reward_patch_x = state.definition.x
        self.reward_patch_y = state.definition.y
        self.reward_transactions = self.reward_transactions + 1
        track(self, "patch_completed", {
            patch_id = state.definition.id,
            meadow_id = state.definition.meadow_id,
            region_id = completed_region_id,
            honey_awarded = result.awarded,
            honey_total = result.honey,
        })
    end
    self.pollination_completion_count = self.pollination_completion_count + 1
    self.audio_hook_count = self.audio_hook_count + 1
    refresh_patch_eligibility(self)

    local meadow_after = region.meadow_status(self.save_state, state.definition.meadow_id)
    local region_after = region.summary(self.save_state, completed_region_id)
    if meadow_before and meadow_after and meadow_before.stage_id ~= "RESTORED" and meadow_after.stage_id == "RESTORED" then
        track(self, "meadow_restored", { meadow_id = state.definition.meadow_id, region_id = completed_region_id, restored_count = region_after.restored_count })
    end
    if region_before and region_after and not region_before.complete and region_after.complete then
        track(self, "region_completed", { region_id = completed_region_id, honey_total = result.honey })
        if not self.qa_enabled then self.home_return_timer = 1.35 end
        portal_event(self, "gameplay_complete", completed_region_id)
        track(self, "gameplay_complete", { region_id = completed_region_id, honey_total = result.honey })
        pcall(sound.play, "#region_complete")
    else
        pcall(sound.play, "#pollination_complete")
    end

    save_progression(self)
    print(string.format(
        "BEBEE_POLLINATION patch_completed id=%s honey_awarded=%d honey_total=%d audio_hook=pollination_complete",
        state.definition.id, result.awarded, result.honey
    ))
end

local function update_pollination(self, movement_distance)
    if not self.pollination_enabled or self.progression_open or self.settings_open
        or self.world_mode ~= ZONE_MODE or not self.zone_puzzle_solved then return end
    local work_multiplier = progression.buzz_work_multiplier(self.save_state)
    local active_region_id = runtime_region_id(self)
    for _, state in ipairs(self.patches) do
        if region.region_id_for_meadow(state.definition.meadow_id) == active_region_id then
            local event = flower_patch.step(state, self.motion.x, self.motion.y, movement_distance, work_multiplier)
            if event.just_completed then complete_patch(self, state) end
        end
    end
end

local function patch_payload_for(self, state)
    local payload = {
        id = state.definition.id,
        meadowId = state.definition.meadow_id,
        flowerId = state.definition.flower_id,
        x = state.definition.x,
        y = state.definition.y,
        radius = state.definition.radius,
        edgeForgiveness = state.definition.edge_forgiveness or 0,
        work = state.work,
        workTarget = state.work_target,
        progress = flower_patch.progress_ratio(state),
        state = state.state,
        inside = state.inside,
        qualifying = state.qualifying,
        workAddedLastStep = state.work_added_last_step,
        movementDistanceLastStep = state.movement_distance_last_step,
        workMultiplierLastStep = state.work_multiplier_last_step,
        requiresBuzzLevel = state.definition.requires_buzz_level or 1,
    }
    local eligible, reason, requirement = progression.patch_eligibility(self.save_state, state.definition)
    payload.eligible = eligible
    payload.eligibilityReason = reason
    payload.requirement = requirement
    return payload
end

local function hive_nearby(self)
    local dx = self.motion.x - HIVE_X
    local dy = self.motion.y - HIVE_Y
    return dx * dx + dy * dy <= HIVE_RADIUS * HIVE_RADIUS
end

local function player_plot_nearby(self, definition)
    local dx = self.motion.x - definition.x
    local dy = self.motion.y - definition.y
    local radius = definition.interaction_radius or 180
    return dx * dx + dy * dy <= radius * radius
end

local function seed_action_text(interaction)
    if interaction.code == "plot_locked" then return "RESTORE NATIVE PATCH FIRST" end
    if interaction.action == "unlock_and_plant" then
        if interaction.affordable then
            return string.format("SPACE / TAP · PLANT %s · %d HONEY", interaction.label or "SEED", interaction.cost or 0)
        end
        return string.format("NEED %d HONEY · %s", interaction.cost or 0, interaction.label or "SEED")
    end
    if interaction.action == "plant_owned" then
        if interaction.current_flower_id then return "SPACE / TAP · REPLANT " .. tostring(interaction.label or "SEED") end
        return "SPACE / TAP · PLANT " .. tostring(interaction.label or "SEED")
    end
    if interaction.code == "waiting_for_more_seeds" then return "MORE SEEDS AFTER NEXT NATIVE PATCH" end
    return ""
end

local function seed_payload_for(self, definition)
    local available, reason, requirement = progression.player_plot_availability(self.save_state, definition.id)
    local interaction = progression.player_plot_interaction(self.save_state, definition.id)
    return {
        id = definition.id,
        x = definition.x,
        y = definition.y,
        visible = self.pollination_enabled and self.world_mode == HOME_MODE,
        available = available,
        availabilityReason = reason,
        requirement = requirement,
        nearby = player_plot_nearby(self, definition),
        currentFlowerId = progression.current_planted_flower(self.save_state, definition.id),
        action = interaction.action,
        actionCode = interaction.code,
        nextSeedId = interaction.seed_id,
        nextFlowerId = interaction.flower_id,
        nextLabel = interaction.label,
        cost = interaction.cost or 0,
        affordable = interaction.affordable ~= false,
        actionText = seed_action_text(interaction),
    }
end

local function send_seed_view(self)
    local plot1 = catalog.player_plots[1]
    local plot2 = catalog.player_plots[2]
    if not plot1 or not plot2 then return end
    local p1 = seed_payload_for(self, plot1)
    local p2 = seed_payload_for(self, plot2)
    msg.post("/seeds#view", "seed_view", {
        camera_x = self.camera.x,
        camera_y = self.camera.y,
        plot1_x = p1.x,
        plot1_y = p1.y,
        plot1_visible = p1.visible,
        plot1_available = p1.available,
        plot1_nearby = p1.nearby,
        plot1_flower_id = p1.currentFlowerId or "",
        plot1_action_text = p1.actionText,
        plot1_affordable = p1.affordable,
        plot2_x = p2.x,
        plot2_y = p2.y,
        plot2_visible = p2.visible,
        plot2_available = p2.available,
        plot2_nearby = p2.nearby,
        plot2_flower_id = p2.currentFlowerId or "",
        plot2_action_text = p2.actionText,
        plot2_affordable = p2.affordable,
    })
end

local function upgrade_view(self, upgrade_id)
    local current = progression.current_upgrade_definition(self.save_state, upgrade_id)
    local next_level = progression.next_upgrade_definition(self.save_state, upgrade_id)
    local available = false
    local availability_code = "max_level"
    if next_level then available, availability_code = progression.is_upgrade_available(self.save_state, upgrade_id) end
    return current, next_level, available, availability_code
end

local function send_progression_view(self)
    if not self.pollination_enabled then return end
    local flight, flight_next, flight_available = upgrade_view(self, "upgrade_flight")
    local buzz, buzz_next, buzz_available = upgrade_view(self, "upgrade_buzz")
    local patch3 = self.patches[3]
    local garden_sink, garden_available, garden_reason, garden_requirement
    for _, sink in ipairs(catalog.honey_sinks or {}) do
        if not progression.is_honey_sink_purchased(self.save_state, sink.id) then
            garden_sink = sink
            garden_available, garden_reason, garden_requirement = progression.honey_sink_availability(self.save_state, sink.id)
            break
        end
    end
    msg.post("/progression#view", "progression_view", {
        camera_x = self.camera.x,
        camera_y = self.camera.y,
        hive_x = HIVE_X,
        hive_y = HIVE_Y,
        hive_nearby = hive_nearby(self),
        modal_open = self.progression_open,
        selected_upgrade = self.selected_upgrade,
        honey = self.save_state.player.honey,
        flight_level = progression.current_upgrade_level(self.save_state, "upgrade_flight"),
        flight_speed = flight and flight.max_speed or 300,
        flight_next_speed = flight_next and flight_next.max_speed or (flight and flight.max_speed or 300),
        flight_cost = flight_next and flight_next.cost or 0,
        flight_available = flight_available,
        flight_affordable = flight_next ~= nil and flight_available and self.save_state.player.honey >= flight_next.cost,
        buzz_level = progression.current_upgrade_level(self.save_state, "upgrade_buzz"),
        buzz_multiplier = buzz and buzz.work_multiplier or 1,
        buzz_next_multiplier = buzz_next and buzz_next.work_multiplier or (buzz and buzz.work_multiplier or 1),
        buzz_cost = buzz_next and buzz_next.cost or 0,
        buzz_available = buzz_available,
        buzz_affordable = buzz_next ~= nil and buzz_available and self.save_state.player.honey >= buzz_next.cost,
        patch3_x = patch3.definition.x,
        patch3_y = patch3.definition.y,
        patch3_state = patch3.state,
        patch3_progress = flower_patch.progress_ratio(patch3),
        garden_label = garden_sink and garden_sink.label or "GARDEN SHOP",
        garden_description = garden_sink and garden_sink.description or "ALL HOME UPGRADES OWNED",
        garden_cost = garden_sink and garden_sink.cost or 0,
        garden_available = garden_available == true,
        garden_purchased = garden_sink == nil,
        garden_reason = garden_reason,
        garden_requirement = garden_requirement,
    })
end

local function nearest_active_portal(self)
    if self.world_mode ~= HOME_MODE then return nil end
    local active = region.active_portal(self.save_state)
    if not active then return nil end
    local dx, dy = self.motion.x - active.x, self.motion.y - active.y
    local radius = active.interaction_radius or PORTAL_INTERACTION_RADIUS
    if dx * dx + dy * dy <= radius * radius then return active end
    return nil
end

local function pointer_active_portal(self, x, y)
    if self.world_mode ~= HOME_MODE then return nil end
    local wx, wy = screen_to_world(self, x, y)
    local active = region.active_portal(self.save_state)
    if active then
        local dx, dy = wx - active.x, wy - active.y
        local radius = active.interaction_radius or PORTAL_INTERACTION_RADIUS
        if dx * dx + dy * dy <= radius * radius then return active end
    end
    return nil
end

local function guidance_target(self)
    if self.world_mode ~= ZONE_MODE then return nil, nil, "portal" end
    if not self.zone_puzzle_solved then
        local target = puzzle.next_target(self.zone_puzzle)
        if target then return target.x, target.y, "puzzle" end
    end
    local active_region_id = runtime_region_id(self)
    for _, state in ipairs(self.patches or {}) do
        local patch_region_id = region.region_id_for_meadow(state.definition.meadow_id)
        if patch_region_id == active_region_id
            and progression.is_patch_eligible(self.save_state, state.definition)
            and not state.completed then
            return state.definition.x, state.definition.y, "patch"
        end
    end
    return nil, nil, "patch"
end

local function active_patch_position(self)
    for _, state in ipairs(self.patches) do
        if state.qualifying then return state.definition.x, state.definition.y end
    end
    return 0, 0
end

local function patch_view_fields(payload, index, state)
    local item = { s = state.state }
    if state.state == "ACTIVE" then item.p = flower_patch.progress_ratio(state) end
    if state.qualifying then item.q = true end
    payload.patch_states[index] = item
end

function send_view(self)
    local touch = input_model.touch_visual(self.input)
    local width, height = surface_size()
    local sx = 1280 / width
    local sy = 720 / height
    local active_x, active_y = active_patch_position(self)
    local active_region_id = runtime_region_id(self)
    local summary = region.summary(self.save_state, active_region_id)
    local guidance_x, guidance_y, guidance_kind = guidance_target(self)
    local portal_states = ""
    for _, definition in ipairs(catalog.portals or {}) do
        local available, reason = region.portal_status(self.save_state, definition.id)
        portal_states = portal_states .. (reason == "restored" and "R" or (available and "A" or "L"))
    end
    local payload = {
        bee_x = self.motion.x,
        bee_y = self.motion.y,
        camera_x = self.camera.x,
        camera_y = self.camera.y,
        speed = self.motion.speed,
        facing_x = self.motion.facing_x,
        dense = self.dense,
        touch_active = touch.active == true and not self.progression_open and not self.settings_open,
        touch_anchor_x = (touch.anchor_x or 0) * sx,
        touch_anchor_y = (touch.anchor_y or 0) * sy,
        touch_knob_x = (touch.knob_x or 0) * sx,
        touch_knob_y = (touch.knob_y or 0) * sy,
        pollination_visible = self.pollination_enabled and self.world_mode == ZONE_MODE,
        world_mode = self.world_mode == ZONE_MODE and "z" or "h",
        zone_region_id = self.zone_region_id,
        zone_puzzle_solved = self.zone_puzzle_solved == true,
        zone_puzzle_progress = self.zone_puzzle and math.floor(puzzle.progress_ratio(self.zone_puzzle) * 100 + 0.5) or 0,
        guidance_x = guidance_x,
        guidance_y = guidance_y,
        guidance_kind = guidance_kind,
        portal_states = portal_states,
        pest_alert = (self.pest_alert_remaining or 0) > 0,
        honey = self.save_state.player.honey,
        reward_amount = self.reward_amount,
        reward_timer = self.reward_feedback_remaining,
        reward_patch_x = self.reward_patch_x,
        reward_patch_y = self.reward_patch_y,
        active_patch_x = active_x,
        active_patch_y = active_y,
        frame = self.frame,
        active_region_id = active_region_id,
        region_restored_count = summary and summary.restored_count or 0,
        region_total = summary and summary.total or 0,
        region_complete = summary and summary.complete or false,
        objective_text = region.objective_text(self.save_state, active_region_id),
        settings_open = self.settings_open,
        selected_setting = self.selected_setting,
        reduced_motion = progression.get_setting(self.save_state, "reduced_motion") == true,
        audio_muted = progression.get_setting(self.save_state, "audio_muted") == true,
    }
    payload.patch_states = {}
    for index, state in ipairs(self.patches) do patch_view_fields(payload, index, state) end
    msg.post("#view", "view_state", payload)
    send_progression_view(self)
    send_seed_view(self)
end

function update_runtime_bridge(self, force)
    if not self.qa_enabled or not html5_available() then return end
    if not force and self.frame % 6 ~= 0 then return end

    local ix, iy, source = input_model.intent(self.input)
    local max_speed = progression.flight_max_speed(self.save_state)
    html5.run("window.__bebeeMovementQA = " .. json.encode({
        schemaVersion = 2,
        stateId = self.qa_state,
        frame = self.frame,
        beeX = self.motion.x,
        beeY = self.motion.y,
        velocityX = self.motion.vx,
        velocityY = self.motion.vy,
        speed = self.motion.speed,
        maxSpeed = max_speed,
        motionState = self.motion.motion_state,
        cameraX = self.camera.x,
        cameraY = self.camera.y,
        intentX = ix,
        intentY = iy,
        inputSource = source,
        reducedMotion = self.reduced_motion,
        boundHits = self.motion.bound_hits,
        distanceTravelled = self.motion.distance_travelled,
    }))

    if self.pollination_enabled then
        local patch_payloads = {}
        for index, state in ipairs(self.patches) do patch_payloads[index] = patch_payload_for(self, state) end
        html5.run("window.__bebeePollinationQA = " .. json.encode({
            schemaVersion = 3,
            stateId = self.qa_state,
            frame = self.frame,
            honey = self.save_state.player.honey,
            patch1 = patch_payloads[1],
            patch2 = patch_payloads[2],
            patch3 = patch_payloads[3],
            patches = patch_payloads,
            completionCount = self.pollination_completion_count,
            rewardTransactions = self.reward_transactions,
            audioHookCount = self.audio_hook_count,
            extraPollinationInput = false,
            saveCode = self.last_save_code,
            saveDurability = self.last_save_durability,
        }))
        local flight, flight_next, flight_available, flight_code = upgrade_view(self, "upgrade_flight")
        local buzz, buzz_next, buzz_available, buzz_code = upgrade_view(self, "upgrade_buzz")
        html5.run("window.__bebeeProgressionQA = " .. json.encode({
            schemaVersion = 2,
            stateId = self.qa_state,
            frame = self.frame,
            modalOpen = self.progression_open,
            selectedUpgrade = self.selected_upgrade,
            hiveNearby = hive_nearby(self),
            honey = self.save_state.player.honey,
            flightLevel = progression.current_upgrade_level(self.save_state, "upgrade_flight"),
            flightMaxSpeed = flight and flight.max_speed or 300,
            flightNextMaxSpeed = flight_next and flight_next.max_speed or nil,
            flightNextCost = flight_next and flight_next.cost or nil,
            flightAvailable = flight_available,
            flightAvailabilityCode = flight_code,
            buzzLevel = progression.current_upgrade_level(self.save_state, "upgrade_buzz"),
            buzzWorkMultiplier = buzz and buzz.work_multiplier or 1,
            buzzNextWorkMultiplier = buzz_next and buzz_next.work_multiplier or nil,
            buzzNextCost = buzz_next and buzz_next.cost or nil,
            buzzAvailable = buzz_available,
            buzzAvailabilityCode = buzz_code,
            patch3 = patch_payloads[3],
            saveCode = self.last_save_code,
            saveDurability = self.last_save_durability,
        }))
        local seed1 = seed_payload_for(self, catalog.player_plots[1])
        local seed2 = seed_payload_for(self, catalog.player_plots[2])
        html5.run("window.__bebeeSeedQA = " .. json.encode({
            schemaVersion = 2,
            stateId = self.qa_state,
            frame = self.frame,
            saveVersion = self.save_state.save_version,
            honey = self.save_state.player.honey,
            ownedSeedIds = progression.owned_seed_ids(self.save_state),
            plot1 = seed1,
            plot2 = seed2,
            nativePatch1Completed = progression.is_patch_completed(self.save_state, catalog.patches[1].id),
            nativePatch2Completed = progression.is_patch_completed(self.save_state, catalog.patches[2].id),
            nativePatch3Completed = progression.is_patch_completed(self.save_state, catalog.patches[3].id),
            saveCode = self.last_save_code,
            saveDurability = self.last_save_durability,
        }))
        local active_region_id = runtime_region_id(self)
        local summary = region.summary(self.save_state, active_region_id)
        html5.run("window.__bebeeRegionQA = " .. json.encode({
            schemaVersion = 2,
            stateId = self.qa_state,
            frame = self.frame,
            activeRegionId = active_region_id,
            region = summary,
            campaign = region.campaign_summary(self.save_state),
            objectiveText = region.objective_text(self.save_state, active_region_id),
            saveVersion = self.save_state.save_version,
            honey = self.save_state.player.honey,
            flightLevel = progression.current_upgrade_level(self.save_state, "upgrade_flight"),
            buzzLevel = progression.current_upgrade_level(self.save_state, "upgrade_buzz"),
            ownedSeedIds = progression.owned_seed_ids(self.save_state),
            playerPlants = self.save_state.world.player_plants,
            settings = self.save_state.player.settings,
            settingsOpen = self.settings_open,
            selectedSetting = self.selected_setting,
            analyticsEvents = analytics.snapshot(self.analytics),
            saveCode = self.last_save_code,
            saveDurability = self.last_save_durability,
            portalTarget = self.portal and self.portal.target or "direct_web",
            portalSdkAvailable = self.portal and self.portal.sdk_available == true or false,
            portalLifecycleState = self.portal and portal.lifecycle_state(self.portal) or "unknown",
            optionalTelemetryAllowed = self.privacy and privacy.telemetry_allowed(self.privacy) or false,
        }))
    end
end

local function mark_capture_ready(self)
    if not self.qa_enabled or not html5_available() then return end
    local state_json = json.encode(self.qa_state)
    local frame = self.frame
    html5.run([[
        (() => {
            const qa = window.__bebeeQA;
            if (!qa || qa.stateId !== ]] .. state_json .. [[) return "missing";
            qa.captureReady = true;
            qa.simulationFrame = ]] .. tostring(frame) .. [[;
            return "ok";
        })()
    ]])
    print(string.format("BEBEE_QA capture_ready state=%s seed=88008 frame=%d", self.qa_state, self.frame))
end

local function open_progression(self)
    if self.progression_open or self.settings_open or not hive_nearby(self) then return false end
    self.progression_open = true
    portal_event(self, "gameplay_stop", "progression_menu")
    track(self, "gameplay_pause", { reason = "progression_menu", region_id = runtime_region_id(self) })
    self.selected_upgrade = "flight"
    input_model.clear(self.input)
    self.motion.vx = 0
    self.motion.vy = 0
    msg.post("/modal#controller", "open_modal", { mode = "progression" })
    send_progression_view(self)
    update_runtime_bridge(self, true)
    print("BEBEE_P3 hive_open")
    return true
end

local function purchase_selected(self, upgrade_id)
    local result
    if self.selected_upgrade == "garden" and not upgrade_id then
        local sink_id
        for _, sink in ipairs(catalog.honey_sinks or {}) do
            if not progression.is_honey_sink_purchased(self.save_state, sink.id) then
                sink_id = sink.id
                break
            end
        end
        result = sink_id and progression.purchase_honey_sink(self.save_state, sink_id) or { ok = false, code = "all_purchased" }
        if result.ok then
            refresh_patch_eligibility(self)
            save_progression(self)
            track(self, "honey_sink_purchased", { sink_id = sink_id, honey_total = result.honey })
            print(string.format("BEBEE_P9 honey_sink_purchased id=%s cost=%d honey=%d", sink_id, result.cost, result.honey))
        else
            print(string.format("BEBEE_P9 honey_sink_rejected id=%s code=%s honey=%d", tostring(sink_id), tostring(result.code), self.save_state.player.honey))
        end
    else
        upgrade_id = upgrade_id or (self.selected_upgrade == "buzz" and "upgrade_buzz" or "upgrade_flight")
        result = progression.purchase_upgrade(self.save_state, upgrade_id)
        if result.ok then
            refresh_patch_eligibility(self)
            save_progression(self)
            print(string.format("BEBEE_P3 upgrade_purchased id=%s level=%d cost=%d honey=%d", upgrade_id, result.level, result.cost, result.honey))
        else
            print(string.format("BEBEE_P3 upgrade_rejected id=%s code=%s honey=%d", upgrade_id, tostring(result.code), self.save_state.player.honey))
        end
    end
    send_progression_view(self)
    send_seed_view(self)
    update_runtime_bridge(self, true)
    return result.ok
end

local function design_point(x, y)
    local width, height = surface_size()
    return (x or 0) * 1280 / width, (y or 0) * 720 / height
end

local function inside(rect, x, y)
    return x >= rect.x1 and x <= rect.x2 and y >= rect.y1 and y <= rect.y2
end

function screen_to_world(self, x, y)
    local dx, dy = design_point(x, y)
    return self.camera.x + dx - 640, self.camera.y + dy - 360
end

local function nearest_player_plot(self)
    local nearest = nil
    local nearest_distance = math.huge
    for _, definition in ipairs(catalog.player_plots or {}) do
        local dx = self.motion.x - definition.x
        local dy = self.motion.y - definition.y
        local distance_sq = dx * dx + dy * dy
        local radius = definition.interaction_radius or 180
        if distance_sq <= radius * radius and distance_sq < nearest_distance then
            nearest = definition
            nearest_distance = distance_sq
        end
    end
    return nearest
end

local function pointer_player_plot(self, x, y)
    local wx, wy = screen_to_world(self, x, y)
    for _, definition in ipairs(catalog.player_plots or {}) do
        local dx = wx - definition.x
        local dy = wy - definition.y
        if dx * dx + dy * dy <= PLOT_POINTER_RADIUS * PLOT_POINTER_RADIUS and player_plot_nearby(self, definition) then
            return definition
        end
    end
    return nil
end

local function interact_player_plot(self, definition)
    if not definition then return false end
    local result = progression.interact_player_plot(self.save_state, definition.id)
    if result.changed then save_progression(self) end
    send_seed_view(self)
    send_progression_view(self)
    update_runtime_bridge(self, true)
    print(string.format(
        "BEBEE_P5 plot_interaction plot=%s code=%s changed=%s seed=%s flower=%s cost=%s honey=%d",
        definition.id, tostring(result.code), tostring(result.changed == true), tostring(result.seed_id),
        tostring(result.flower_id or result.current_flower_id), tostring(result.cost or 0), self.save_state.player.honey
    ))
    return true
end

local function primary_action(self)
    if self.progression_open or self.settings_open then return false end
    local portal_definition = nearest_active_portal(self)
    if portal_definition and enter_active_portal(self, portal_definition) then return true end
    local plot = nearest_player_plot(self)
    if plot then return interact_player_plot(self, plot) end
    return open_progression(self)
end

local function open_settings(self)
    if self.settings_open or self.progression_open then return false end
    mark_first_input(self, "modal_toggle")
    self.settings_open = true
    portal_event(self, "gameplay_stop", "settings_menu")
    track(self, "gameplay_pause", { reason = "settings_menu", region_id = runtime_region_id(self) })
    self.selected_setting = "reduced_motion"
    input_model.clear(self.input)
    self.motion.vx = 0
    self.motion.vy = 0
    msg.post("/modal#controller", "open_modal", { mode = "settings" })
    send_view(self)
    update_runtime_bridge(self, true)
    print("BEBEE_P6 settings_open")
    return true
end

local function toggle_selected_setting(self, setting_id)
    setting_id = setting_id or self.selected_setting
    local result = progression.toggle_setting(self.save_state, setting_id)
    if not result.ok then return false end
    if setting_id == "reduced_motion" then self.reduced_motion = result.value end
    if setting_id == "audio_muted" then apply_audio_setting(self) end
    if result.changed then
        track(self, "settings_changed", { setting_id = setting_id, value = result.value })
        save_progression(self)
    end
    send_view(self)
    update_runtime_bridge(self, true)
    print(string.format("BEBEE_P6 setting id=%s value=%s", setting_id, tostring(result.value)))
    return true
end

function init(self)
    self.qa_enabled = sys.get_config_boolean("bebee.qa_enabled", false)
    self.qa_state = query_value("qa")
    self.dense = self.qa_state == MOVEMENT_DENSE

    local width, height = surface_size()
    self.input = input_model.new({ surface_width = width, surface_height = height })
    self.motion = movement.new()
    self.camera = follow.new()
    self.frame = 0
    self.view_ready = false
    self.progression_view_ready = false
    self.seed_view_ready = false
    self.qa_ready_sent = false
    self.pollination_completion_count = 0
    self.reward_transactions = 0
    self.audio_hook_count = 0
    self.reward_amount = 0
    self.reward_feedback_remaining = 0
    self.reward_patch_x = 0
    self.reward_patch_y = 0
    self.progression_open = false
    self.settings_open = false
    self.selected_upgrade = "flight"
    self.selected_setting = "reduced_motion"
    self.first_input_seen = false
    self.pollination_enabled = not movement_only_qa(self.qa_state) and query_value("storage_test") == ""
    self.world_mode = self.qa_enabled and ZONE_MODE or HOME_MODE
    self.zone_region_id = nil
    self.zone_puzzle = nil
    self.zone_puzzle_solved = self.qa_enabled
    self.home_return_timer = 0
    self.enemies = {}
    for index = 1, 3 do
        self.enemies[index] = {
            phase = index * 2.17,
            orbit_x = 190 + index * 42,
            orbit_y = 130 + index * 28,
            x = 0,
            y = 0,
        }
    end
    self.pest_alert_remaining = 0
    self.pest_slow_remaining = 0
    self.pest_contact_cooldown = 0
    self.pest_contact_count = 0
    self.analytics = analytics.new(analytics_adapter)
    self.privacy = privacy.new({
        telemetry_enabled = sys.get_config_boolean("bebee.telemetry_enabled", false),
    })
    self.portal = portal.new({
        target = sys.get_config_string("bebee.portal_target", "direct_web"),
        telemetry_enabled = privacy.telemetry_allowed(self.privacy),
    })

    load_progression(self)

    local query_reduced = query_value("reduced_motion")
    if query_reduced == "1" then
        self.reduced_motion = true
    elseif query_reduced == "0" then
        self.reduced_motion = false
    elseif progression.get_setting(self.save_state, "reduced_motion") == true then
        self.reduced_motion = true
    elseif html5_available() then
        self.reduced_motion = html5.run("window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches") == true
    else
        self.reduced_motion = false
    end

    apply_audio_setting(self)
    build_patch_states(self)
    apply_visual_fixture(self)
    track(self, "session_start", { region_id = runtime_region_id(self), save_version = self.save_state.save_version })

    go.set("#camera", "orthographic_zoom", 1.0)
    go.set_position(vmath.vector3(self.camera.x, self.camera.y, 0))
end

function final(self)
    portal_event(self, "gameplay_stop", "application_end")
    if self.qa_enabled and html5_available() then
        html5.run("delete window.__bebeeMovementQA; delete window.__bebeePollinationQA; delete window.__bebeeProgressionQA; delete window.__bebeeSeedQA; delete window.__bebeeRegionQA")
    end
end

function update(self, dt)
    self.frame = self.frame + 1
    if self.home_return_timer > 0 then
        self.home_return_timer = math.max(0, self.home_return_timer - dt)
        if self.home_return_timer == 0 then go_home(self) end
    end
    update_enemies(self, dt)
    local width, height = surface_size()
    input_model.resize(self.input, width, height)
    local ix, iy = input_model.intent(self.input)
    if self.progression_open or self.settings_open then ix, iy = 0, 0 end
    local distance_before = self.motion.distance_travelled
    local travel_multiplier = (not self.qa_enabled and self.pest_slow_remaining > 0) and 0.72 or 1
    movement.step(self.motion, ix, iy, dt, {
        max_speed = progression.flight_max_speed(self.save_state) * travel_multiplier,
    })
    local movement_distance = self.motion.distance_travelled - distance_before
    update_zone_puzzle(self)
    update_pollination(self, movement_distance)
    follow.step(self.camera, self.motion.x, self.motion.y, dt, self.reduced_motion)
    go.set_position(vmath.vector3(self.camera.x, self.camera.y, 0))

    if self.reward_feedback_remaining > 0 and self.reward_feedback_remaining < 900 then
        self.reward_feedback_remaining = math.max(0, self.reward_feedback_remaining - dt)
    end

    send_view(self)
    update_runtime_bridge(self, false)

    local needs_progression_view = progression_qa(self.qa_state) or restoration_qa(self.qa_state)
    local needs_seed_view = seed_qa(self.qa_state)
    local required_views_ready = self.view_ready
        and (not needs_progression_view or self.progression_view_ready)
        and (not needs_seed_view or self.seed_view_ready)
    if required_views_ready and self.qa_enabled
        and qa_runtime.requires_gameplay_capture(self.qa_state)
        and not self.qa_ready_sent and self.frame >= 2 then
        self.qa_ready_sent = true
        update_runtime_bridge(self, true)
        mark_capture_ready(self)
    end
end

function on_message(self, message_id, message)
    if message_id == hash("view_ready") then
        self.view_ready = true
        send_view(self)
        return
    end
    if message_id == hash("progression_view_ready") then
        self.progression_view_ready = true
        send_progression_view(self)
        return
    end
    if message_id == hash("seed_view_ready") then
        self.seed_view_ready = true
        send_seed_view(self)
        return
    end
    if message_id == hash("movement_input_clear") then
        input_model.clear(self.input)
        return
    end
    if message_id == hash("movement_key_input") then
        if message.pressed then
            input_model.set_key(self.input, message.action_name, true)
            mark_first_input(self, message.action_name)
        elseif message.released then
            input_model.set_key(self.input, message.action_name, false)
        end
        return
    end
    if message_id == hash("progression_primary") then
        mark_first_input(self, "primary_action")
        primary_action(self)
        return
    end
    if message_id == hash("settings_open_request") then
        open_settings(self)
        return
    end
    if message_id == hash("settings_modal_closed") then
        self.settings_open = false
        portal_event(self, "gameplay_start", "settings_resume")
        track(self, "gameplay_resume", { reason = "settings_resume", region_id = runtime_region_id(self) })
        input_model.clear(self.input)
        send_view(self)
        update_runtime_bridge(self, true)
        print("BEBEE_P6 settings_closed")
        return
    end
    if message_id == hash("settings_modal_navigation") and self.settings_open then
        if message.action_name == "move_up" or message.action_name == "move_left" then self.selected_setting = "reduced_motion" end
        if message.action_name == "move_down" or message.action_name == "move_right" then self.selected_setting = "audio_muted" end
        send_view(self)
        update_runtime_bridge(self, true)
        return
    end
    if message_id == hash("settings_modal_toggle") and self.settings_open then
        toggle_selected_setting(self)
        return
    end
    if message_id == hash("settings_modal_pointer") and self.settings_open then
        local x, y = design_point(message.x, message.y)
        if inside(SETTINGS_REDUCED_ROW, x, y) then
            self.selected_setting = "reduced_motion"
            toggle_selected_setting(self, "reduced_motion")
        elseif inside(SETTINGS_AUDIO_ROW, x, y) then
            self.selected_setting = "audio_muted"
            toggle_selected_setting(self, "audio_muted")
        end
        return
    end
    if message_id == hash("progression_modal_closed") then
        self.progression_open = false
        portal_event(self, "gameplay_start", "progression_resume")
        track(self, "gameplay_resume", { reason = "progression_resume", region_id = runtime_region_id(self) })
        input_model.clear(self.input)
        send_progression_view(self)
        send_seed_view(self)
        update_runtime_bridge(self, true)
        print("BEBEE_P3 hive_closed")
        return
    end
    if message_id == hash("progression_modal_navigation") and self.progression_open then
        if message.action_name == "move_left" then self.selected_upgrade = "flight" end
        if message.action_name == "move_right" then self.selected_upgrade = "buzz" end
        if message.action_name == "move_down" then
            if self.selected_upgrade == "flight" then self.selected_upgrade = "buzz" else self.selected_upgrade = "garden" end
        end
        if message.action_name == "move_up" then
            if self.selected_upgrade == "garden" then self.selected_upgrade = "buzz" else self.selected_upgrade = "flight" end
        end
        send_progression_view(self)
        update_runtime_bridge(self, true)
        return
    end
    if message_id == hash("progression_modal_purchase") and self.progression_open then
        purchase_selected(self)
        return
    end
    if message_id == hash("progression_modal_pointer") and self.progression_open then
        local x, y = design_point(message.x, message.y)
        if inside(FLIGHT_CARD, x, y) then
            self.selected_upgrade = "flight"
            purchase_selected(self, "upgrade_flight")
        elseif inside(BUZZ_CARD, x, y) then
            self.selected_upgrade = "buzz"
            purchase_selected(self, "upgrade_buzz")
        elseif inside(GARDEN_CARD, x, y) then
            self.selected_upgrade = "garden"
            purchase_selected(self)
        end
        return
    end
    if message_id == hash("movement_pointer_input") then
        local width, height = surface_size()
        input_model.resize(self.input, width, height)
        if message.pressed then
            mark_first_input(self, "pointer_primary")
            local portal_definition = pointer_active_portal(self, message.x, message.y)
            if portal_definition and enter_active_portal(self, portal_definition) then return end
            local plot = pointer_player_plot(self, message.x, message.y)
            if plot and interact_player_plot(self, plot) then return end
            local x, y = design_point(message.x, message.y)
            if hive_nearby(self) and inside(HIVE_BUTTON, x, y) and open_progression(self) then return end
            input_model.pointer_press(self.input, message.x, message.y)
        elseif message.released then
            input_model.pointer_release(self.input, message.x, message.y)
        else
            input_model.pointer_move(self.input, message.x, message.y)
        end
        return
    end
    if message_id == hash("movement_pointer_move") then
        input_model.pointer_move(self.input, message.x, message.y)
    end
end
