local catalog = require "data.catalog"
local meadow = require "gameplay.world.meadow"

local DESIGN_W = 1280
local DESIGN_H = 720
local BEE_SCALE = 2.0
local WORLD_W = 9600
local WORLD_H = 2400
local FIRST_MEADOW = catalog.meadows[1]
local PATCH_POOL_SIZE = 6
local PATCH_VISIBILITY_MARGIN = 300
local PATH_STEPS = 5

local COLOR_GREEN = vmath.vector4(0.475, 0.788, 0.396, 1)
local COLOR_DORMANT = vmath.vector4(0.588, 0.643, 0.478, 1)
local COLOR_GOLDEN_DORMANT = vmath.vector4(0.68, 0.62, 0.36, 1)
local COLOR_GOLDEN_FIELD = vmath.vector4(0.79, 0.76, 0.38, 1)
local COLOR_WETLAND_DORMANT = vmath.vector4(0.34, 0.52, 0.53, 1)
local COLOR_WETLAND_FIELD = vmath.vector4(0.35, 0.70, 0.58, 1)
local COLOR_ROSEWOOD_DORMANT = vmath.vector4(0.28, 0.36, 0.30, 1)
local COLOR_ROSEWOOD_FIELD = vmath.vector4(0.49, 0.66, 0.42, 1)
local COLOR_DARK = vmath.vector4(0.286, 0.231, 0.196, 1)
local COLOR_CREAM = vmath.vector4(1.0, 0.969, 0.91, 1)
local COLOR_HONEY = vmath.vector4(0.965, 0.718, 0.235, 1)
local COLOR_ACTIVE = vmath.vector4(0.471, 0.839, 0.910, 1)
local COLOR_SUCCESS = vmath.vector4(0.416, 0.796, 0.463, 1)
local COLOR_LOCKED = vmath.vector4(0.482, 0.431, 0.557, 0.86)
local COLOR_DAISY = vmath.vector4(1.0, 0.94, 0.82, 1)
local COLOR_CLOVER = vmath.vector4(0.82, 0.93, 0.72, 1)
local COLOR_LAVENDER = vmath.vector4(0.73, 0.61, 0.88, 1)
local COLOR_TULIP = vmath.vector4(0.96, 0.52, 0.49, 1)
local COLOR_LILY = vmath.vector4(0.83, 0.94, 1.0, 1)
local COLOR_SUNFLOWER = vmath.vector4(1.0, 0.79, 0.25, 1)
local COLOR_POPPY = vmath.vector4(0.94, 0.31, 0.27, 1)
local COLOR_LOTUS = vmath.vector4(1.0, 0.67, 0.76, 1)
local COLOR_IRIS = vmath.vector4(0.54, 0.58, 0.94, 1)
local COLOR_ROSE = vmath.vector4(0.92, 0.43, 0.48, 1)
local COLOR_BLUEBELL = vmath.vector4(0.43, 0.58, 0.82, 1)
local COLOR_POLLEN = vmath.vector4(0.965, 0.718, 0.235, 0.62)
local COLOR_PATH = vmath.vector4(0.96, 0.86, 0.57, 0.34)
local COLOR_WATER = vmath.vector4(0.36, 0.72, 0.86, 0.42)
local COLOR_ROOT = vmath.vector4(0.48, 0.35, 0.23, 0.86)
local COLOR_REED = vmath.vector4(0.34, 0.58, 0.31, 0.90)
local COLOR_WOOD = vmath.vector4(0.32, 0.20, 0.14, 0.90)
local COLOR_CANOPY = vmath.vector4(0.20, 0.40, 0.24, 0.78)

local FLOWER_OFFSETS = {
    { -118, -54 }, { -102, 74 }, { 0, 118 }, { 104, 72 }, { 118, -56 },
}

local function box(x, y, w, h, color)
    local node = gui.new_box_node(vmath.vector3(x, y, 0), vmath.vector3(w, h, 0))
    gui.set_color(node, color)
    return node
end

local function text_node(x, y, value, scale)
    local node = gui.new_text_node(vmath.vector3(x, y, 0), value)
    gui.set_font(node, "default")
    gui.set_color(node, COLOR_CREAM)
    gui.set_scale(node, vmath.vector3(scale or 1, scale or 1, 1))
    return node
end

local function set_xy(node, x, y)
    gui.set_position(node, vmath.vector3(x, y, 0))
end

local function set_size(node, w, h)
    gui.set_size(node, vmath.vector3(w, h, 0))
end

local function world_to_screen(wx, wy, camera_x, camera_y)
    return DESIGN_W * 0.5 + wx - camera_x, DESIGN_H * 0.5 + wy - camera_y
end

local function camera_region_id(camera_x)
    if camera_x > 6400 then return "region_04" end
    if camera_x > 4560 then return "region_03" end
    if camera_x > 2400 then return "region_02" end
    return "region_01"
end

local function html5_available()
    return html5 ~= nil and html5.run ~= nil
end

local function query_value(name)
    if not html5_available() then return "" end
    return html5.run("new URLSearchParams(window.location.search).get(" .. json.encode(name) .. ") || ''") or ""
end

local function mix_color(a, b, amount)
    amount = math.max(0, math.min(1, amount or 0))
    return vmath.vector4(
        a.x + (b.x - a.x) * amount,
        a.y + (b.y - a.y) * amount,
        a.z + (b.z - a.z) * amount,
        1
    )
end

local function flower_color(flower_id)
    if flower_id == "flower_clover" then return COLOR_CLOVER end
    if flower_id == "flower_lavender" then return COLOR_LAVENDER end
    if flower_id == "flower_tulip" then return COLOR_TULIP end
    if flower_id == "flower_lily" then return COLOR_LILY end
    if flower_id == "flower_sunflower" then return COLOR_SUNFLOWER end
    if flower_id == "flower_poppy" then return COLOR_POPPY end
    if flower_id == "flower_lotus" then return COLOR_LOTUS end
    if flower_id == "flower_iris" then return COLOR_IRIS end
    if flower_id == "flower_rose" then return COLOR_ROSE end
    if flower_id == "flower_bluebell" then return COLOR_BLUEBELL end
    return COLOR_DAISY
end

local function stage_definition(stage_id)
    for _, definition in ipairs(FIRST_MEADOW.restoration_stages or {}) do
        if definition.id == stage_id then return definition end
    end
    return FIRST_MEADOW.restoration_stages[1]
end

local function completed(state)
    return state == "COMPLETED" and 1 or 0
end

local function patch_state_id(message, index)
    local item = message.patch_states and message.patch_states[index]
    return item and item.s or "LOCKED"
end

local function first_meadow_status(message, patch3_completed_fallback)
    local contribution = completed(patch_state_id(message, 1)) + completed(patch_state_id(message, 2))
    if patch_state_id(message, 3) == "COMPLETED" or patch3_completed_fallback then contribution = contribution + 1 end
    return meadow.stage_for_contribution(FIRST_MEADOW, contribution)
end

local function region_restoration_progress(message, region_id)
    local definition
    for _, candidate in ipairs(catalog.regions or {}) do
        if candidate.id == region_id then definition = candidate break end
    end
    if not definition then return 0, 1 end
    local restored = 0
    for _, meadow_id in ipairs(definition.meadow_ids or {}) do
        local found = false
        local complete = true
        for patch_index, patch in ipairs(catalog.patches or {}) do
            if patch.meadow_id == meadow_id then
                found = true
                if patch_state_id(message, patch_index) ~= "COMPLETED" then complete = false end
            end
        end
        if found and complete then restored = restored + 1 end
    end
    return restored, math.max(1, #(definition.meadow_ids or {}))
end

local function publish_restoration_bridge(self, status, stage, detail_count, objective_text)
    if not self.qa_enabled or not html5_available() then return end
    html5.run("window.__bebeeRestorationQA = Object.assign(window.__bebeeRestorationQA || {}, " .. json.encode({
        schemaVersion = 1,
        meadowId = FIRST_MEADOW.id,
        stageId = status.stage_id,
        stageIndex = status.stage_index,
        contribution = status.contribution,
        restorationTarget = status.target,
        restorationProgress = status.progress,
        groundMix = stage.ground_mix or 0,
        detailCount = detail_count,
        hudHidden = self.hud_hidden,
        objectiveText = objective_text,
    }) .. ")")
end

local function create_flower()
    return {
        stem = box(0, 0, 6, 34, vmath.vector4(0.243,0.510,0.278,0.92)),
        center = box(0, 0, 13, 13, COLOR_HONEY),
        petal_left = box(0, 0, 9, 12, COLOR_DAISY),
        petal_right = box(0, 0, 9, 12, COLOR_DAISY),
        petal_top = box(0, 0, 12, 9, COLOR_DAISY),
        petal_bottom = box(0, 0, 12, 9, COLOR_DAISY),
    }
end

local function create_patch_visual()
    local patch = {
        halo = box(0, 0, 300, 260, vmath.vector4(1,1,1,0.05)),
        progress_bg = box(0, 0, 184, 16, vmath.vector4(0.12,0.18,0.12,0.36)),
        progress_fill = box(0, 0, 180, 10, COLOR_ACTIVE),
        lock_text = text_node(0, 0, "LOCKED", 0.82),
        flowers = {},
    }
    for index = 1, #FLOWER_OFFSETS do patch.flowers[index] = create_flower() end
    return patch
end

local function set_flower_visual(flower, wx, wy, camera_x, camera_y, bloom, locked, petal_color, flower_id)
    local sx, sy = world_to_screen(wx, wy, camera_x, camera_y)
    local petal = locked and COLOR_LOCKED or petal_color
    local center = locked and COLOR_LOCKED or COLOR_HONEY
    local stem = locked and COLOR_LOCKED or vmath.vector4(0.243,0.510,0.278,0.92)
    local petal_size = 5 + 12 * bloom
    local spread_x = 8 + 6 * bloom
    local spread_y = spread_x
    local side_w = petal_size
    local side_h = petal_size * 1.3
    local vertical_w = petal_size * 1.3
    local vertical_h = petal_size
    local center_size = 13

    if flower_id == "flower_clover" then
        spread_x = 6 + 4 * bloom
        spread_y = spread_x
        side_w, side_h = petal_size * 1.15, petal_size * 1.15
        vertical_w, vertical_h = side_w, side_h
        center = locked and COLOR_LOCKED or vmath.vector4(0.28,0.55,0.30,1)
    elseif flower_id == "flower_lavender" then
        spread_x = 5 + 3 * bloom
        spread_y = 10 + 9 * bloom
        side_w, side_h = petal_size * 0.45, petal_size * 1.55
        vertical_w, vertical_h = petal_size * 0.55, petal_size * 1.45
        center_size = 9
    elseif flower_id == "flower_tulip" then
        spread_x = 7 + 4 * bloom
        spread_y = 7 + 4 * bloom
        side_w, side_h = petal_size * 1.05, petal_size * 1.45
        vertical_w, vertical_h = petal_size * 1.35, petal_size * 0.95
        center_size = 10
    elseif flower_id == "flower_lily" then
        spread_x = 10 + 7 * bloom
        spread_y = spread_x
        side_w, side_h = petal_size * 0.55, petal_size * 1.75
        vertical_w, vertical_h = petal_size * 1.75, petal_size * 0.55
        center_size = 10
    elseif flower_id == "flower_sunflower" then
        spread_x = 12 + 8 * bloom
        spread_y = spread_x
        side_w, side_h = petal_size * 0.52, petal_size * 1.65
        vertical_w, vertical_h = petal_size * 1.65, petal_size * 0.52
        center_size = 16 + 5 * bloom
        center = locked and COLOR_LOCKED or COLOR_DARK
    elseif flower_id == "flower_poppy" then
        spread_x = 8 + 5 * bloom
        spread_y = spread_x
        side_w, side_h = petal_size * 1.25, petal_size * 1.25
        vertical_w, vertical_h = side_w, side_h
        center_size = 12 + 2 * bloom
        center = locked and COLOR_LOCKED or COLOR_DARK
    elseif flower_id == "flower_lotus" then
        spread_x = 12 + 9 * bloom
        spread_y = 7 + 4 * bloom
        side_w, side_h = petal_size * 1.55, petal_size * 0.82
        vertical_w, vertical_h = petal_size * 1.18, petal_size * 0.86
        center_size = 14 + 2 * bloom
    elseif flower_id == "flower_iris" then
        spread_x = 4 + 2 * bloom
        spread_y = 14 + 10 * bloom
        side_w, side_h = petal_size * 0.48, petal_size * 1.85
        vertical_w, vertical_h = petal_size * 0.58, petal_size * 2.05
        center_size = 8
    elseif flower_id == "flower_rose" then
        spread_x = 10 + 6 * bloom
        spread_y = 9 + 6 * bloom
        side_w, side_h = petal_size * 1.18, petal_size * 1.10
        vertical_w, vertical_h = petal_size * 1.10, petal_size * 1.18
        center_size = 12 + 3 * bloom
        center = locked and COLOR_LOCKED or vmath.vector4(0.55,0.19,0.20,1)
    elseif flower_id == "flower_bluebell" then
        spread_x = 7 + 4 * bloom
        spread_y = 13 + 8 * bloom
        side_w, side_h = petal_size * 0.72, petal_size * 1.35
        vertical_w, vertical_h = petal_size * 0.92, petal_size * 1.52
        center_size = 9
        center = locked and COLOR_LOCKED or vmath.vector4(0.22,0.32,0.56,1)
    end

    gui.set_color(flower.stem, stem)
    gui.set_color(flower.center, center)
    gui.set_color(flower.petal_left, petal)
    gui.set_color(flower.petal_right, petal)
    gui.set_color(flower.petal_top, petal)
    gui.set_color(flower.petal_bottom, petal)

    set_xy(flower.stem, sx, sy - 18)
    set_xy(flower.center, sx, sy)
    set_xy(flower.petal_left, sx - spread_x, sy)
    set_xy(flower.petal_right, sx + spread_x, sy)
    set_xy(flower.petal_top, sx, sy + spread_y)
    set_xy(flower.petal_bottom, sx, sy - spread_y)

    set_size(flower.center, center_size, center_size)
    set_size(flower.petal_left, side_w, side_h)
    set_size(flower.petal_right, side_w, side_h)
    set_size(flower.petal_top, vertical_w, vertical_h)
    if flower_id == "flower_tulip" then
        set_size(flower.petal_bottom, petal_size * 0.55, petal_size * 0.55)
    else
        set_size(flower.petal_bottom, vertical_w, vertical_h)
    end
end

local function render_patch(patch, definition, state, progress, camera_x, camera_y, visible)
    gui.set_enabled(patch.halo, visible)
    gui.set_enabled(patch.progress_bg, visible and state == "ACTIVE")
    gui.set_enabled(patch.progress_fill, visible and state == "ACTIVE")
    gui.set_enabled(patch.lock_text, visible and state == "LOCKED")
    for _, flower in ipairs(patch.flowers) do
        for _, node in pairs(flower) do gui.set_enabled(node, visible) end
    end
    if not visible or not definition then return end

    local sx, sy = world_to_screen(definition.x, definition.y, camera_x, camera_y)
    local locked = state == "LOCKED"
    local completed_state = state == "COMPLETED"
    local bloom = completed_state and 1 or math.max(0.18, progress)
    local halo_color
    if locked then
        halo_color = vmath.vector4(0.482,0.431,0.557,0.20)
    elseif completed_state then
        halo_color = vmath.vector4(COLOR_SUCCESS.x,COLOR_SUCCESS.y,COLOR_SUCCESS.z,0.20)
    elseif state == "ACTIVE" then
        halo_color = vmath.vector4(COLOR_ACTIVE.x,COLOR_ACTIVE.y,COLOR_ACTIVE.z,0.20)
    else
        halo_color = vmath.vector4(1.0,1.0,1.0,0.08)
    end
    gui.set_color(patch.halo, halo_color)
    set_xy(patch.halo, sx, sy)

    local petal_color = flower_color(definition.flower_id)
    for index, offset in ipairs(FLOWER_OFFSETS) do
        set_flower_visual(
            patch.flowers[index], definition.x + offset[1], definition.y + offset[2], camera_x, camera_y,
            bloom, locked, petal_color, definition.flower_id
        )
    end

    local bar_y = sy + 146
    local width = 180 * math.max(0, math.min(1, progress))
    set_xy(patch.progress_bg, sx, bar_y)
    set_size(patch.progress_fill, math.max(1, width), 10)
    set_xy(patch.progress_fill, sx - 90 + math.max(1, width) * 0.5, bar_y)
    set_xy(patch.lock_text, sx, bar_y)
end

local function nearby_patch_indices(camera_x, camera_y)
    local candidates = {}
    for index, definition in ipairs(catalog.patches) do
        local sx, sy = world_to_screen(definition.x, definition.y, camera_x, camera_y)
        if sx >= -PATCH_VISIBILITY_MARGIN and sx <= DESIGN_W + PATCH_VISIBILITY_MARGIN
            and sy >= -PATCH_VISIBILITY_MARGIN and sy <= DESIGN_H + PATCH_VISIBILITY_MARGIN then
            local dx = sx - DESIGN_W * 0.5
            local dy = sy - DESIGN_H * 0.5
            candidates[#candidates + 1] = { index = index, distance = dx * dx + dy * dy }
        end
    end
    table.sort(candidates, function(a, b) return a.distance < b.distance end)
    return candidates
end

local function create_meadow_marker(definition, index)
    local marker = {
        definition = definition,
        zone = box(0, 0, index == 1 and 560 or 390, index == 1 and 470 or 340, vmath.vector4(0.90,0.85,0.55,0.10)),
        ring = box(0, 0, 250, 18, vmath.vector4(1,1,1,0.10)),
                title = text_node(0, 0, definition.label or definition.id, 0.72),
        landmark = text_node(0, 0, definition.landmark or "", 0.56),
    }
    gui.set_color(marker.landmark, vmath.vector4(1.0,0.90,0.66,0.86))
    return marker
end

local function meadow_completed(message, meadow_id)
    local found = false
    for patch_index, definition in ipairs(catalog.patches) do
        if definition.meadow_id == meadow_id then
            found = true
            if patch_state_id(message, patch_index) ~= "COMPLETED" then return false end
        end
    end
    return found
end

local function render_meadow_marker(marker, index, restored, camera_x, camera_y)
    local definition = marker.definition
    local sx, sy = world_to_screen(definition.center_x, definition.center_y, camera_x, camera_y)
    local zone_color = restored and vmath.vector4(0.36,0.72,0.39,0.18) or vmath.vector4(0.53,0.48,0.36,0.15)
    if index == 4 then zone_color = restored and vmath.vector4(0.32,0.71,0.58,0.18) or vmath.vector4(0.36,0.58,0.62,0.14) end
    if index == 5 then zone_color = restored and vmath.vector4(0.82,0.58,0.38,0.18) or vmath.vector4(0.56,0.46,0.34,0.14) end
    if index == 6 then zone_color = restored and vmath.vector4(0.59,0.73,0.82,0.20) or vmath.vector4(0.48,0.45,0.54,0.14) end
    if definition.region_id == "region_02" then
        zone_color = restored and vmath.vector4(0.91,0.72,0.24,0.22) or vmath.vector4(0.58,0.49,0.27,0.18)
    elseif definition.region_id == "region_03" then
        zone_color = restored and vmath.vector4(0.31,0.76,0.61,0.22) or vmath.vector4(0.31,0.52,0.55,0.18)
    elseif definition.region_id == "region_04" then
        zone_color = restored and vmath.vector4(0.55,0.74,0.43,0.22) or vmath.vector4(0.27,0.39,0.30,0.18)
    end
    gui.set_color(marker.zone, zone_color)
    gui.set_color(marker.ring, restored and vmath.vector4(COLOR_HONEY.x,COLOR_HONEY.y,COLOR_HONEY.z,0.56) or vmath.vector4(1,1,1,0.12))
    set_xy(marker.zone, sx, sy)
    set_xy(marker.ring, sx, sy - 145)
    set_xy(marker.title, sx, sy + 150)
    set_xy(marker.landmark, sx, sy + 116)
end

local function create_path_nodes()
    local nodes = {}
    for index = 1, (#catalog.meadows - 1) * PATH_STEPS do nodes[index] = box(0, 0, 22, 12, COLOR_PATH) end
    return nodes
end

local function render_paths(self, camera_x, camera_y)
    local node_index = 1
    for meadow_index = 1, #catalog.meadows - 1 do
        local a = catalog.meadows[meadow_index]
        local b = catalog.meadows[meadow_index + 1]
        for step = 1, PATH_STEPS do
            local t = step / (PATH_STEPS + 1)
            local wx = a.center_x + (b.center_x - a.center_x) * t
            local wy = a.center_y + (b.center_y - a.center_y) * t
            local sx, sy = world_to_screen(wx, wy, camera_x, camera_y)
            set_xy(self.path_nodes[node_index], sx, sy)
            node_index = node_index + 1
        end
    end
end

local function create_settings(self)
    self.settings = {
        shade = box(640, 360, 1280, 720, vmath.vector4(0.08,0.10,0.08,0.68)),
        panel = box(640, 350, 660, 390, vmath.vector4(0.14,0.18,0.14,0.96)),
        title = text_node(640, 500, "SETTINGS", 1.25),
        hint = text_node(640, 185, "ARROWS · SELECT     SPACE · TOGGLE     ESC · CLOSE", 0.62),
        reduced_bg = box(640, 395, 600, 80, vmath.vector4(1,1,1,0.06)),
        reduced_label = text_node(475, 395, "REDUCED MOTION", 0.86),
        reduced_value = text_node(805, 395, "OFF", 0.86),
        audio_bg = box(640, 280, 600, 80, vmath.vector4(1,1,1,0.06)),
        audio_label = text_node(475, 280, "AUDIO", 0.86),
        audio_value = text_node(805, 280, "ON", 0.86),
    }
    for _, node in pairs(self.settings) do gui.set_enabled(node, false) end
end

local function render_settings(self, message)
    local visible = message.settings_open == true
    for _, node in pairs(self.settings) do gui.set_enabled(node, visible) end
    if not visible then return end
    gui.set_text(self.settings.reduced_value, message.reduced_motion == true and "ON" or "OFF")
    gui.set_text(self.settings.audio_value, message.audio_muted == true and "MUTED" or "ON")
    gui.set_color(self.settings.reduced_bg,
        message.selected_setting == "reduced_motion" and vmath.vector4(COLOR_HONEY.x,COLOR_HONEY.y,COLOR_HONEY.z,0.24) or vmath.vector4(1,1,1,0.06))
    gui.set_color(self.settings.audio_bg,
        message.selected_setting == "audio_muted" and vmath.vector4(COLOR_HONEY.x,COLOR_HONEY.y,COLOR_HONEY.z,0.24) or vmath.vector4(1,1,1,0.06))
end

function init(self)
    self.qa_enabled = sys.get_config_boolean("bebee.qa_enabled", false)
    self.hud_hidden = self.qa_enabled and query_value("hud_hidden") == "1"
    self.patch3_completed = false
    self.background = box(640, 360, 1280, 720, COLOR_GREEN)

    self.decorations = {}
    local points = {
        {180,190},{330,340},{520,180},{690,430},{840,240},{1010,560},{1210,210},{1390,430},
        {1580,250},{1770,610},{1970,330},{2180,740},{280,1120},{470,1320},{760,1080},{980,1390},
        {1300,1160},{1510,1340},{1840,1080},{2140,1280},{410,760},{620,900},{890,650},{1110,980},
        {1450,760},{1690,930},{1920,820},{2240,1020},{330,520},{560,1450},{1170,250},{2220,460},
        {2520,380},{2670,720},{2860,1080},{3010,1390},{3190,520},{3400,1240},{3550,710},{3720,1430},
        {3890,860},{4070,330},{4200,1030},{4380,670},{2580,1460},{3140,260},{3650,1110},{4310,1390},
        {4680,350},{4870,920},{5120,440},{5330,1450},{5580,1040},{5850,330},{6140,1220},{6460,1660},
        {6760,300},{7040,1010},{7320,420},{7610,1660},{7900,260},{8190,1160},{8480,520},{8780,1840},{9100,960},{9400,420},
    }
    for index, point in ipairs(points) do
        local rosewood = point[1] > 6400
        local wetland = point[1] > 4560 and not rosewood
        local golden = point[1] > 2400 and not wetland and not rosewood
        local dark = index % 3 == 0
        local color
        if rosewood then
            color = dark and vmath.vector4(0.18,0.30,0.19,0.76) or vmath.vector4(0.58,0.78,0.48,0.62)
        elseif wetland then
            color = dark and vmath.vector4(0.20,0.46,0.42,0.72) or vmath.vector4(0.70,0.90,0.76,0.60)
        elseif golden then
            color = dark and vmath.vector4(0.48,0.38,0.18,0.68) or vmath.vector4(1.0,0.88,0.48,0.62)
        else
            color = dark and vmath.vector4(0.243,0.510,0.278,0.72) or vmath.vector4(1.0,0.969,0.91,0.55)
        end
        local node = box(0, 0, dark and 18 or 13, dark and 28 or 20, color)
        self.decorations[index] = { node = node, x = point[1], y = point[2], golden = golden, wetland = wetland, rosewood = rosewood }
    end

    self.edge_left = box(0, 0, 18, WORLD_H, vmath.vector4(0.243,0.510,0.278,0.75))
    self.edge_right = box(0, 0, 18, WORLD_H, vmath.vector4(0.24,0.54,0.48,0.78))
    self.edge_bottom = box(0, 0, WORLD_W, 18, vmath.vector4(0.243,0.510,0.278,0.75))
    self.edge_top = box(0, 0, WORLD_W, 18, vmath.vector4(0.24,0.54,0.48,0.78))

    self.path_nodes = create_path_nodes()
    self.meadow_markers = {}
    for index, definition in ipairs(catalog.meadows) do self.meadow_markers[index] = create_meadow_marker(definition, index) end

    self.creek = box(0, 0, 520, 72, COLOR_WATER)
    self.creek_bridge = box(0, 0, 118, 88, vmath.vector4(0.66,0.48,0.28,0.82))
    self.sun_dial = box(0, 0, 34, 128, vmath.vector4(0.94,0.76,0.40,0.82))
    self.lily_arch_left = box(0, 0, 28, 190, vmath.vector4(0.90,0.82,0.48,0.80))
    self.lily_arch_right = box(0, 0, 28, 190, vmath.vector4(0.90,0.82,0.48,0.80))
    self.lily_arch_top = box(0, 0, 220, 28, vmath.vector4(0.90,0.82,0.48,0.80))
    self.golden_gate_left = box(0, 0, 28, 190, vmath.vector4(0.93,0.69,0.22,0.90))
    self.golden_gate_right = box(0, 0, 28, 190, vmath.vector4(0.93,0.69,0.22,0.90))
    self.golden_gate_top = box(0, 0, 230, 26, vmath.vector4(0.93,0.69,0.22,0.90))
    self.windmill_tower = box(0, 0, 36, 170, vmath.vector4(0.55,0.38,0.22,0.90))
    self.windmill_blade_h = box(0, 0, 220, 16, vmath.vector4(1.0,0.93,0.69,0.88))
    self.windmill_blade_v = box(0, 0, 16, 220, vmath.vector4(1.0,0.93,0.69,0.88))

    self.wetland_channel_a = box(0, 0, 520, 92, vmath.vector4(COLOR_WATER.x,COLOR_WATER.y,COLOR_WATER.z,0.54))
    self.wetland_channel_b = box(0, 0, 420, 82, vmath.vector4(COLOR_WATER.x,COLOR_WATER.y,COLOR_WATER.z,0.50))
    self.reed_gate_left = box(0, 0, 18, 150, COLOR_REED)
    self.reed_gate_right = box(0, 0, 18, 150, COLOR_REED)
    self.reed_gate_top = box(0, 0, 170, 16, COLOR_REED)
    self.rootwalk_h = box(0, 0, 260, 28, COLOR_ROOT)
    self.rootwalk_v = box(0, 0, 28, 170, COLOR_ROOT)
    self.dragonfly_pool = box(0, 0, 360, 170, vmath.vector4(COLOR_WATER.x,COLOR_WATER.y,COLOR_WATER.z,0.58))
    self.rosewood_trunk_left = box(0, 0, 42, 240, COLOR_WOOD)
    self.rosewood_trunk_right = box(0, 0, 42, 220, COLOR_WOOD)
    self.rosewood_canopy = box(0, 0, 420, 190, COLOR_CANOPY)
    self.rosewood_roots = box(0, 0, 360, 26, COLOR_WOOD)
    self.rosewood_arch_left = box(0, 0, 24, 180, vmath.vector4(0.52,0.34,0.20,0.84))
    self.rosewood_arch_right = box(0, 0, 24, 180, vmath.vector4(0.52,0.34,0.20,0.84))

    self.patch_pool = {}
    for index = 1, PATCH_POOL_SIZE do self.patch_pool[index] = create_patch_visual() end

    self.shadow = box(640, 340, 76 * BEE_SCALE, 22 * BEE_SCALE, vmath.vector4(0.12,0.18,0.12,0.20))
    self.wing_left = box(612, 375, 38 * BEE_SCALE, 34 * BEE_SCALE, vmath.vector4(1.0,0.969,0.91,0.70))
    self.wing_right = box(668, 375, 38 * BEE_SCALE, 34 * BEE_SCALE, vmath.vector4(1.0,0.969,0.91,0.70))
    self.body = box(640, 360, 66 * BEE_SCALE, 54 * BEE_SCALE, COLOR_HONEY)
    self.stripe_left = box(627, 360, 10 * BEE_SCALE, 54 * BEE_SCALE, COLOR_DARK)
    self.stripe_right = box(648, 360, 10 * BEE_SCALE, 54 * BEE_SCALE, COLOR_DARK)
    self.head = box(674, 360, 27 * BEE_SCALE, 42 * BEE_SCALE, COLOR_DARK)

    self.objective_bg = box(258, 664, 450, 48, vmath.vector4(0.12,0.18,0.12,0.58))
    self.objective = text_node(258, 664, "RESTORE FIRST PATCH · 0/6", 0.76)
    self.honey_bg = box(1120, 664, 220, 48, vmath.vector4(0.12,0.18,0.12,0.58))
    self.honey_icon = box(1048, 664, 24, 24, COLOR_HONEY)
    self.honey_text = text_node(1135, 664, "HONEY 0", 1.0)
    self.reward_text = text_node(0, 0, "+0 HONEY", 1.1)
    gui.set_color(self.reward_text, COLOR_HONEY)
    gui.set_enabled(self.reward_text, false)

    self.pollen = {}
    for index = 1, 8 do
        self.pollen[index] = box(0, 0, 8, 8, COLOR_POLLEN)
        gui.set_enabled(self.pollen[index], false)
    end

    self.joy_base = box(0, 0, 118, 118, vmath.vector4(1,1,1,0.13))
    self.joy_knob = box(0, 0, 42, 42, vmath.vector4(1,0.969,0.91,0.38))
    gui.set_enabled(self.joy_base, false)
    gui.set_enabled(self.joy_knob, false)

    create_settings(self)
    msg.post("#controller", "view_ready")
end

function final(self)
    if self.qa_enabled and html5_available() then html5.run("delete window.__bebeeRestorationQA") end
end

function on_message(self, message_id, message)
    if message_id == hash("restoration_patch3") then
        self.patch3_completed = message.completed == true
        return
    end
    if message_id ~= hash("view_state") then return end

    local camera_x = message.camera_x or 1200
    local camera_y = message.camera_y or 800
    local dense = message.dense == true
    local pollination_visible = message.pollination_visible == true
    local active_region_id = message.active_region_id or "region_01"
    local visual_region_id = camera_region_id(camera_x)
    local status = first_meadow_status(message, self.patch3_completed)
    local stage = stage_definition(status.stage_id)
    local detail_count
    local objective_text = message.objective_text or "RESTORE FIRST PATCH · 0/6"

    if pollination_visible then
        local visible_restored, visible_total = region_restoration_progress(message, visual_region_id)
        local visible_progress = visible_restored / visible_total
        if visual_region_id == "region_03" then
            detail_count = #self.decorations
            gui.set_color(self.background, mix_color(COLOR_WETLAND_DORMANT, COLOR_WETLAND_FIELD, 0.30 + visible_progress * 0.70))
        elseif visual_region_id == "region_02" then
            detail_count = #self.decorations
            gui.set_color(self.background, mix_color(COLOR_GOLDEN_DORMANT, COLOR_GOLDEN_FIELD, 0.32 + visible_progress * 0.68))
        else
            detail_count = math.min(#self.decorations, (stage.detail_count or 8) + visible_restored * 2)
            gui.set_color(self.background, mix_color(COLOR_DORMANT, COLOR_GREEN,
                math.max(stage.ground_mix or 0, visible_progress * 0.72)))
        end
    else
        detail_count = dense and #self.decorations or 12
        gui.set_color(self.background, COLOR_GREEN)
    end

    for index, decoration in ipairs(self.decorations) do
        local x, y = world_to_screen(decoration.x, decoration.y, camera_x, camera_y)
        set_xy(decoration.node, x, y)
        local enabled = index <= detail_count
        if pollination_visible and visual_region_id == "region_01" and (decoration.golden or decoration.wetland or decoration.rosewood) then enabled = false end
        if pollination_visible and visual_region_id == "region_02" and (decoration.wetland or decoration.rosewood) then enabled = false end
        if pollination_visible and visual_region_id == "region_03" and decoration.rosewood then enabled = false end
        gui.set_enabled(decoration.node, enabled)
    end

    if pollination_visible then
        render_paths(self, camera_x, camera_y)
        for index, marker in ipairs(self.meadow_markers) do
            render_meadow_marker(marker, index, meadow_completed(message, marker.definition.id), camera_x, camera_y)
        end
    end
    for _, node in ipairs(self.path_nodes) do gui.set_enabled(node, pollination_visible) end
    for _, marker in ipairs(self.meadow_markers) do
        for key, node in pairs(marker) do if key ~= "definition" then gui.set_enabled(node, pollination_visible) end end
    end

    local creek_x, creek_y = world_to_screen(730, 430, camera_x, camera_y)
    set_xy(self.creek, creek_x, creek_y - 78)
    set_xy(self.creek_bridge, creek_x, creek_y - 78)
    gui.set_enabled(self.creek, pollination_visible)
    gui.set_enabled(self.creek_bridge, pollination_visible)
    local sun_x, sun_y = world_to_screen(430, 980, camera_x, camera_y)
    set_xy(self.sun_dial, sun_x - 120, sun_y)
    gui.set_enabled(self.sun_dial, pollination_visible)
    local lily_x, lily_y = world_to_screen(760, 1380, camera_x, camera_y)
    set_xy(self.lily_arch_left, lily_x - 100, lily_y)
    set_xy(self.lily_arch_right, lily_x + 100, lily_y)
    set_xy(self.lily_arch_top, lily_x, lily_y + 82)
    gui.set_enabled(self.lily_arch_left, pollination_visible)
    gui.set_enabled(self.lily_arch_right, pollination_visible)
    gui.set_enabled(self.lily_arch_top, pollination_visible)

    local gate_x, gate_y = world_to_screen(2720, 1260, camera_x, camera_y)
    set_xy(self.golden_gate_left, gate_x - 105, gate_y)
    set_xy(self.golden_gate_right, gate_x + 105, gate_y)
    set_xy(self.golden_gate_top, gate_x, gate_y + 84)
    gui.set_enabled(self.golden_gate_left, pollination_visible)
    gui.set_enabled(self.golden_gate_right, pollination_visible)
    gui.set_enabled(self.golden_gate_top, pollination_visible)
    local wind_x, wind_y = world_to_screen(4040, 1190, camera_x, camera_y)
    set_xy(self.windmill_tower, wind_x, wind_y)
    set_xy(self.windmill_blade_h, wind_x, wind_y + 72)
    set_xy(self.windmill_blade_v, wind_x, wind_y + 72)
    gui.set_enabled(self.windmill_tower, pollination_visible)
    gui.set_enabled(self.windmill_blade_h, pollination_visible)
    gui.set_enabled(self.windmill_blade_v, pollination_visible)

    local wetland_visible = pollination_visible and visual_region_id == "region_03"
    local channel_a_x, channel_a_y = world_to_screen(5100, 920, camera_x, camera_y)
    set_xy(self.wetland_channel_a, channel_a_x, channel_a_y)
    local channel_b_x, channel_b_y = world_to_screen(5750, 660, camera_x, camera_y)
    set_xy(self.wetland_channel_b, channel_b_x, channel_b_y)
    local reed_x, reed_y = world_to_screen(4800, 560, camera_x, camera_y)
    set_xy(self.reed_gate_left, reed_x - 78, reed_y)
    set_xy(self.reed_gate_right, reed_x + 78, reed_y)
    set_xy(self.reed_gate_top, reed_x, reed_y + 68)
    local root_x, root_y = world_to_screen(5740, 780, camera_x, camera_y)
    set_xy(self.rootwalk_h, root_x, root_y - 78)
    set_xy(self.rootwalk_v, root_x + 105, root_y)
    local basin_x, basin_y = world_to_screen(6060, 1540, camera_x, camera_y)
    set_xy(self.dragonfly_pool, basin_x, basin_y - 88)
    gui.set_enabled(self.wetland_channel_a, wetland_visible)
    gui.set_enabled(self.wetland_channel_b, wetland_visible)
    gui.set_enabled(self.reed_gate_left, wetland_visible)
    gui.set_enabled(self.reed_gate_right, wetland_visible)
    gui.set_enabled(self.reed_gate_top, wetland_visible)
    gui.set_enabled(self.rootwalk_h, wetland_visible)
    gui.set_enabled(self.rootwalk_v, wetland_visible)
    gui.set_enabled(self.dragonfly_pool, wetland_visible)

    local rosewood_visible = pollination_visible and visual_region_id == "region_04"
    local rose_x, rose_y = world_to_screen(6800, 620, camera_x, camera_y)
    set_xy(self.rosewood_trunk_left, rose_x - 138, rose_y)
    set_xy(self.rosewood_trunk_right, rose_x + 138, rose_y + 10)
    set_xy(self.rosewood_canopy, rose_x, rose_y + 126)
    set_xy(self.rosewood_roots, rose_x, rose_y - 112)
    local arch_x, arch_y = world_to_screen(7350, 1380, camera_x, camera_y)
    set_xy(self.rosewood_arch_left, arch_x - 118, arch_y)
    set_xy(self.rosewood_arch_right, arch_x + 118, arch_y)
    gui.set_enabled(self.rosewood_trunk_left, rosewood_visible)
    gui.set_enabled(self.rosewood_trunk_right, rosewood_visible)
    gui.set_enabled(self.rosewood_canopy, rosewood_visible)
    gui.set_enabled(self.rosewood_roots, rosewood_visible)
    gui.set_enabled(self.rosewood_arch_left, rosewood_visible)
    gui.set_enabled(self.rosewood_arch_right, rosewood_visible)

    msg.post("/progression#view", "restoration_base", {
        contribution = status.contribution,
        stage_id = status.stage_id,
        frame = message.frame or 0,
        hud_hidden = self.hud_hidden,
    })

    local lx, ly = world_to_screen(0, WORLD_H * 0.5, camera_x, camera_y)
    local rx, ry = world_to_screen(WORLD_W, WORLD_H * 0.5, camera_x, camera_y)
    local bx, by = world_to_screen(WORLD_W * 0.5, 0, camera_x, camera_y)
    local tx, ty = world_to_screen(WORLD_W * 0.5, WORLD_H, camera_x, camera_y)
    set_xy(self.edge_left, lx, ly)
    set_xy(self.edge_right, rx, ry)
    set_xy(self.edge_bottom, bx, by)
    set_xy(self.edge_top, tx, ty)

    local any_qualifying = false
    for index = 1, #catalog.patches do
        local patch_state = message.patch_states and message.patch_states[index]
        if patch_state and patch_state.q == true then any_qualifying = true end
    end

    local nearby = pollination_visible and nearby_patch_indices(camera_x, camera_y) or {}
    for slot = 1, PATCH_POOL_SIZE do
        local candidate = nearby[slot]
        if candidate then
            local index = candidate.index
            local patch_state = message.patch_states and message.patch_states[index] or {}
            render_patch(
                self.patch_pool[slot], catalog.patches[index],
                patch_state.s or "LOCKED",
                patch_state.p or 0,
                camera_x, camera_y, true
            )
        else
            render_patch(self.patch_pool[slot], nil, "LOCKED", 0, camera_x, camera_y, false)
        end
    end

    local hud_visible = pollination_visible and not self.hud_hidden
    gui.set_enabled(self.objective_bg, hud_visible)
    gui.set_enabled(self.objective, hud_visible)
    gui.set_enabled(self.honey_bg, hud_visible)
    gui.set_enabled(self.honey_icon, hud_visible)
    gui.set_enabled(self.honey_text, hud_visible)
    if hud_visible then
        gui.set_text(self.honey_text, "HONEY " .. tostring(math.floor(message.honey or 0)))
        if any_qualifying then
            objective_text = string.format("POLLINATION IN PROGRESS · %d/%d", message.region_restored_count or 0, message.region_total or 0)
        end
        gui.set_text(self.objective, objective_text)
    end

    local reward_visible = hud_visible and (message.reward_timer or 0) > 0
    gui.set_enabled(self.reward_text, reward_visible)
    if reward_visible then
        gui.set_text(self.reward_text, "+" .. tostring(math.floor(message.reward_amount or 0)) .. " HONEY")
        local reward_x, reward_y = world_to_screen(message.reward_patch_x or 0, (message.reward_patch_y or 0) + 175, camera_x, camera_y)
        set_xy(self.reward_text, reward_x, reward_y)
    end

    local active_x = message.active_patch_x or 0
    local active_y = message.active_patch_y or 0
    local pollen_active = pollination_visible and any_qualifying
    for index, node in ipairs(self.pollen) do
        gui.set_enabled(node, pollen_active)
        if pollen_active then
            local angle = (message.frame or 0) * 0.10 + index * 0.785
            local radius = 82 + (index % 2) * 18
            local px, py = world_to_screen(active_x + math.cos(angle) * radius, active_y + math.sin(angle) * radius, camera_x, camera_y)
            set_xy(node, px, py)
        end
    end

    local bee_x, bee_y = world_to_screen(message.bee_x or 1200, message.bee_y or 800, camera_x, camera_y)
    local speed_ratio = math.min(1, (message.speed or 0) / 360)
    local wing_lift = (10 + speed_ratio * 10) * BEE_SCALE
    local facing_left = (message.facing_x or 1) < 0
    local head_offset = (facing_left and -35 or 35) * BEE_SCALE
    set_xy(self.shadow, bee_x, bee_y - 31 * BEE_SCALE)
    set_xy(self.wing_left, bee_x - 27 * BEE_SCALE, bee_y + wing_lift)
    set_xy(self.wing_right, bee_x + 27 * BEE_SCALE, bee_y + wing_lift)
    set_xy(self.body, bee_x, bee_y)
    set_xy(self.stripe_left, bee_x - 13 * BEE_SCALE, bee_y)
    set_xy(self.stripe_right, bee_x + 8 * BEE_SCALE, bee_y)
    set_xy(self.head, bee_x + head_offset, bee_y)

    local touch_active = message.touch_active == true
    gui.set_enabled(self.joy_base, touch_active)
    gui.set_enabled(self.joy_knob, touch_active)
    if touch_active then
        set_xy(self.joy_base, message.touch_anchor_x or 0, message.touch_anchor_y or 0)
        set_xy(self.joy_knob, message.touch_knob_x or 0, message.touch_knob_y or 0)
    end

    render_settings(self, message)
    publish_restoration_bridge(self, status, stage, detail_count, objective_text)
end
