local testlib = require "tests.testlib"

local suites = {
    require "tests.test_input_semantics",
    require "tests.test_data_validation",
    require "tests.test_qa_runtime",
    require "tests.test_storage",
    require "tests.test_storage_preservation",
    require "tests.test_movement",
    require "tests.test_movement_input",
    require "tests.test_camera_follow",
    require "tests.test_flower_patch",
    require "tests.test_economy",
    require "tests.test_progression",
}

local function emit(event)
    print("BEBEE_TEST " .. json.encode(event))
end

function init(self)
    local summary = testlib.run(suites, emit)
    sys.exit(summary.failed == 0 and 0 or 1)
end
