local input = require "app.input_semantics"

function init(self)
    msg.post(".", "acquire_input_focus")
    print("BEBEE_INPUT gameplay_focus acquired")
end

function final(self)
    msg.post(".", "release_input_focus")
end

function on_input(self, action_id, action)
    local action_name = input.name(action_id)
    if not action_name then
        return false
    end

    if action_id == input.MODAL_TOGGLE and action.pressed then
        print("BEBEE_INPUT gameplay modal_toggle pressed")
        msg.post("/modal#controller", "open_modal")
        return false
    end

    if input.is_movement(action_id) and action.pressed then
        print("BEBEE_INPUT gameplay " .. action_name .. " pressed")
    elseif action_id == input.PRIMARY_ACTION and action.pressed then
        print("BEBEE_INPUT gameplay primary_action pressed")
    elseif action_id == input.POINTER_PRIMARY and action.pressed then
        local pointer = input.pointer(action)
        print(string.format("BEBEE_INPUT gameplay pointer_primary pressed x=%.1f y=%.1f", pointer.x, pointer.y))
    end

    return false
end
