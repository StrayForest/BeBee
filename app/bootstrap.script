local qa_runtime = require "app.qa_runtime"
local storage_probe = require "app.storage_probe"
local input_semantics = require "app.input_semantics"

local function html5_available()
    return html5 ~= nil and html5.run ~= nil
end

local function set_qa_bridge(self, capture_ready)
    if not self.qa_enabled or not html5_available() then return end
    local request = self.qa_request
    local payload = {
        schemaVersion = qa_runtime.SCHEMA_VERSION,
        stateId = request.state_id,
        seed = request.seed,
        engineReady = true,
        captureReady = capture_ready == true and request.supported,
        simulationFrame = self.qa_simulation_frame or 0,
        buildCommitSha = self.qa_build_sha,
        error = request.error,
    }
    html5.run("window.__bebeeQA = " .. json.encode(payload))
end

local function install_foundation_probe(self)
    if not self.qa_enabled or not html5_available() then return end
    if self.qa_request.state_id ~= qa_runtime.FOUNDATION_STATE then return end
    local label = string.format("BeBee QA · %s · seed %d", self.qa_request.state_id, self.qa_request.seed)
    local label_json = json.encode(label)
    html5.run([[
        (() => {
            const previous = document.getElementById("bebee-qa-foundation-probe");
            if (previous) previous.remove();
            const probe = document.createElement("div");
            probe.id = "bebee-qa-foundation-probe";
            probe.setAttribute("data-bebee-qa", "foundation_probe");
            probe.style.cssText = ["position:fixed","left:50%","top:50%","transform:translate(-50%,-50%)","z-index:2147483647","box-sizing:border-box","padding:18px 24px","border:2px solid rgba(255,255,255,0.92)","border-radius:14px","background:rgba(15,18,24,0.88)","color:#fff","font:600 18px/1.35 system-ui,sans-serif","letter-spacing:0.01em","white-space:nowrap","pointer-events:none"].join(";");
            probe.textContent = ]] .. label_json .. [[;
            document.body.appendChild(probe);
            return "ok";
        })()
    ]])
end

local function init_qa(self)
    self.qa_enabled = sys.get_config_boolean("bebee.qa_enabled", false)
    if not self.qa_enabled or not html5_available() then return end

    local requested_state = html5.run("new URLSearchParams(window.location.search).get('qa') || ''")
    local requested_seed = html5.run("new URLSearchParams(window.location.search).get('qa_seed') || ''")
    self.qa_request = qa_runtime.resolve_request(requested_state, requested_seed)
    if requested_state == "" then return end

    self.qa_build_sha = sys.get_config_string("bebee.build_commit_sha", "unavailable")
    self.qa_simulation_frame = 0
    self.qa_marked = false
    self.movement_ready = false
    set_qa_bridge(self, false)
    if self.qa_request.error then
        print("BEBEE_QA unknown_state " .. self.qa_request.state_id)
        return
    end
    if self.qa_request.supported then
        install_foundation_probe(self)
        print(string.format("BEBEE_QA state_applied state=%s seed=%d build=%s", self.qa_request.state_id, self.qa_request.seed, self.qa_build_sha))
    end
end

local function mark_qa_capture_ready(self)
    if not self.qa_enabled or not self.qa_request or not self.qa_request.supported or self.qa_marked then return end
    self.qa_marked = true
    set_qa_bridge(self, true)
    print(string.format("BEBEE_QA capture_ready state=%s seed=%d frame=%d", self.qa_request.state_id, self.qa_request.seed, self.qa_simulation_frame or 0))
end

local function maybe_mark_ready(self)
    if not self.qa_request then return end
    if self.qa_request.state_id == qa_runtime.FOUNDATION_STATE and self.proxy_ready then
        mark_qa_capture_ready(self)
    elseif qa_runtime.is_movement_state(self.qa_request.state_id) and self.proxy_ready and self.movement_ready then
        mark_qa_capture_ready(self)
    end
end

function init(self)
    self.proxy_ready = false
    self.owner_focused = false
    self.movement_input_blocked = false
    init_qa(self)
    if self.qa_enabled then storage_probe.run() end
    msg.post("/sentinel#controller", "acquire_sentinel_focus")
    msg.post("#input_probe", "load")
end

function final(self)
    if self.owner_focused then msg.post(".", "release_input_focus") end
    if self.proxy_ready then
        msg.post("#input_probe", "disable")
        msg.post("#input_probe", "unload")
    end
end

function on_message(self, message_id, message, sender)
    if message_id == hash("sentinel_focus_ready") and not self.owner_focused then
        self.owner_focused = true
        msg.post(".", "acquire_input_focus")
        print("BEBEE_INPUT owner_focus acquired")
    elseif message_id == hash("proxy_loaded") then
        msg.post(sender, "init")
        msg.post(sender, "enable")
        self.proxy_ready = true
        print("BEBEE_INPUT proxy_loaded owner_focus=1")
        maybe_mark_ready(self)
    elseif message_id == hash("movement_qa_ready") then
        self.movement_ready = true
        self.qa_simulation_frame = message.frame or 0
        maybe_mark_ready(self)
    elseif message_id == hash("modal_input_blocked") then
        self.movement_input_blocked = message.blocked == true
        if self.movement_input_blocked then
            msg.post("/movement#controller", "movement_input_clear")
        end
        print("BEBEE_INPUT movement_router blocked=" .. (self.movement_input_blocked and "1" or "0"))
    end
end

function on_input(self, action_id, action)
    if input_semantics.is_movement(action_id) then
        if not self.movement_input_blocked and (action.pressed or action.released) then
            msg.post("/movement#controller", "movement_key_input", {
                action_name = input_semantics.name(action_id),
                pressed = action.pressed == true,
                released = action.released == true,
            })
        end
        return false
    end

    if action_id == input_semantics.POINTER_PRIMARY then
        if not self.movement_input_blocked then
            msg.post("/movement#controller", "movement_pointer_input", {
                x = action.x or 0,
                y = action.y or 0,
                pressed = action.pressed == true,
                released = action.released == true,
            })
        end
        return false
    end

    if not self.movement_input_blocked and action_id == nil and action.x and action.y then
        msg.post("/movement#controller", "movement_pointer_move", {
            x = action.x,
            y = action.y,
        })
    end
    return false
end
