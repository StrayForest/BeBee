local input = require "app.input_semantics"

function init(self)
    self.open = false
end

function final(self)
    if self.open then
        msg.post(".", "release_input_focus")
    end
end

function on_message(self, message_id)
    if message_id == hash("open_modal") and not self.open then
        self.open = true
        msg.post("/movement#controller", "movement_input_clear")
        msg.post(".", "acquire_input_focus")
        print("BEBEE_INPUT modal_open focus_acquired")
    end
end

function on_input(self, action_id, action)
    if not self.open then
        return false
    end

    local action_name = input.name(action_id)

    if action_id == input.MODAL_TOGGLE and action.pressed then
        self.open = false
        msg.post(".", "release_input_focus")
        print("BEBEE_INPUT modal_closed focus_released")
        return true
    end

    if action_name and action.pressed then
        print("BEBEE_INPUT modal_consumed " .. action_name .. " pressed")
    end

    return true
end
