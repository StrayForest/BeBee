local input = require "app.input_semantics"

local function close_modal(self)
    local mode = self.mode
    self.open = false
    self.mode = nil
    msg.post(".", "release_input_focus")
    if mode == "progression" then msg.post("/movement#controller", "progression_modal_closed") end
    if mode == "settings" then msg.post("/movement#controller", "settings_modal_closed") end
    print("BEBEE_INPUT modal_closed focus_released")
end

function init(self)
    self.open = false
    self.mode = nil
end

function final(self)
    if self.open then msg.post(".", "release_input_focus") end
end

function on_message(self, message_id, message)
    if message_id == hash("open_modal") and not self.open then
        self.open = true
        self.mode = message.mode or "probe"
        msg.post("/movement#controller", "movement_input_clear")
        msg.post(".", "acquire_input_focus")
        print("BEBEE_INPUT modal_open focus_acquired mode=" .. tostring(self.mode))
    end
end

function on_input(self, action_id, action)
    if not self.open then return false end

    local action_name = input.name(action_id)
    if action_id == input.MODAL_TOGGLE and action.pressed then
        close_modal(self)
        return true
    end

    if self.mode == "progression" then
        if input.is_movement(action_id) and action.pressed then
            msg.post("/movement#controller", "progression_modal_navigation", { action_name = action_name })
        elseif action_id == input.PRIMARY_ACTION and action.pressed then
            msg.post("/movement#controller", "progression_modal_purchase")
        elseif action_id == input.POINTER_PRIMARY and action.pressed then
            local pointer = input.pointer(action)
            msg.post("/movement#controller", "progression_modal_pointer", { x = pointer.x, y = pointer.y })
        end
    elseif self.mode == "settings" then
        if input.is_movement(action_id) and action.pressed then
            msg.post("/movement#controller", "settings_modal_navigation", { action_name = action_name })
        elseif action_id == input.PRIMARY_ACTION and action.pressed then
            msg.post("/movement#controller", "settings_modal_toggle")
        elseif action_id == input.POINTER_PRIMARY and action.pressed then
            local pointer = input.pointer(action)
            msg.post("/movement#controller", "settings_modal_pointer", { x = pointer.x, y = pointer.y })
        end
    end

    if action_name and action.pressed then print("BEBEE_INPUT modal_consumed " .. action_name .. " pressed") end
    return true
end
