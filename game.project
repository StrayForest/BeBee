[project]
title = BeBee
version = 0.0.1

[bootstrap]
main_collection = /app/bootstrap.collectionc

[input]
game_binding = /app/game.input_bindingc
use_accelerometer = 0

[display]
width = 1280
height = 720
high_dpi = 1

[html5]
scale_mode = stretch
wasm_streaming = 1
show_fullscreen_button = 0
show_made_with_defold = 0

[bebee]
storage_application_id = com.strayforest.bebee
